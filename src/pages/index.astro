---
import CityPhoto from "../components/CityPhoto.astro";
import HeroMap from "../components/HeroMap.astro";
import Base from "../layouts/Base.astro";

const error = Astro.url.searchParams.get("error");
---

<Base title="Spots: places to go, picked together" newGroup={false}>
  <div class="home">
  <div class="hero">
  {/* The invite's photo, so the home page, an invite and a shared link all
      open on the same view of the city; as the page scrolls it turns into
      the map (src/scripts/fly.ts). */}
  <section class="fly" aria-labelledby="fly-title">
    <div class="fly__stage">
      <div class="fly__map" aria-hidden="true"></div>
      <div class="fly__intro">
        {/* (filling the screen: as wide as the screen, or one and a half
            times as wide as it is tall, whichever is wider) */}
        <CityPhoto class="hero__photo fly__photo" sizes="(max-aspect-ratio: 151/100) 151vh, 100vw" first />
        <div class="hero__words fly__words">
          <h1 id="fly-title">Canboring?</h1>
          <p class="hero__answer">Not when your friends pick the places.</p>
          <p class="hero__cta">
            <a class="btn btn--primary fly__start" href="#start">Start a group</a>
            <span class="fine">Free, and no sign-up</span>
          </p>
        </div>
        {/* (the photo's colour at its top and its foot, for the phone's
            browser to carry on under its bars: styles.css) */}
        <span class="fly__edge fly__edge--top" aria-hidden="true"></span>
        <span class="fly__edge fly__edge--foot" aria-hidden="true"></span>
        {/* (with the flight only: it plays it for you) */}
        <button class="fly__go" type="button">
          See it from above
          <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M10 4v11M5.5 10.5 10 15l4.5-4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      </div>
      <div class="fly__card"><HeroMap /></div>
      <p class="fly__credit fine" aria-hidden="true">© OpenStreetMap · OpenFreeMap · relief Mapzen</p>
    </div>
  </section>

  <section id="start" class="card start" aria-labelledby="start-title">
    <h2 id="start-title">Start a group</h2>
    <p class="fine">No sign-up. Anyone with your group's link joins by typing a name.</p>
    <form method="post" action="/api/groups" class="stack card__actions">
      {error && <p class="notice" role="alert">Give the group a name, and tell everyone yours.</p>}
      <label>
        <span>Group name</span>
        <input name="group" required maxlength="60" placeholder="Saturday crew" autocomplete="off" />
      </label>
      <label>
        <span>Your name</span>
        <input name="name" required maxlength="40" placeholder="What your friends call you" autocomplete="nickname" />
      </label>
      <button class="btn btn--primary start__go">
        <span>Start and get the link</span>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <path d="M4 10h11M11 5.5 15.5 10 11 14.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </form>
  </section>
  </div>
  </div>
  <script>
    // (the map and its code only with motion allowed: without, the page is
    // the photo and the drawn map under it)
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) import("../scripts/fly.ts");
  </script>
</Base>
