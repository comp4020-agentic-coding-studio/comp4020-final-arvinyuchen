---
import HeroMap from "../components/HeroMap.astro";
import SpotPhoto from "../components/SpotPhoto.astro";
import Base from "../layouts/Base.astro";
import { CATALOGUE, KIND_LABEL } from "../lib/catalogue";

const error = Astro.url.searchParams.get("error");
const sample = CATALOGUE.filter((_, i) => i % 3 === 0).slice(0, 4);
---

<Base title="Spots: places to go, picked together">
  <div class="hero">
  <section class="hero__intro">
    <p class="eyebrow">
      <span class="pins" aria-hidden="true"><span class="pin-dot pin-dot--food"></span><span class="pin-dot pin-dot--fun"></span><span class="pin-dot pin-dot--outdoors"></span></span>
      Places to go in Canberra
    </p>
    <h1>Where are we going?</h1>
    <p class="lede">
      Explore food spots, fun places and things to do around Canberra, each with a reason it's good. Describe what
      you're after, find it on the map, then pick together with your friends.
    </p>
  </section>

  <HeroMap />

  <section id="start" class="card start" aria-labelledby="start-title">
    <h2 id="start-title">Start a group</h2>
    {error && <p class="notice" role="alert">Give the group a name, and tell everyone yours.</p>}
    <form method="post" action="/api/groups" class="stack">
      <label>
        <span>Group name</span>
        <input name="group" required maxlength="60" placeholder="Saturday crew" autocomplete="off" />
      </label>
      <label>
        <span>Your name</span>
        <input name="name" required maxlength="40" placeholder="What your friends call you" autocomplete="nickname" />
      </label>
      <button class="btn btn--primary">Start and get the link</button>
    </form>
    <p class="fine">No sign-up. Anyone with your group's link joins by typing a name.</p>
  </section>
  </div>

  <section class="how" aria-labelledby="how-title">
    <h2 id="how-title">How it works</h2>
    <ol class="steps">
      <li><span><strong>Explore</strong> places shared by everyone on Spots, or describe what you're after.</span></li>
      <li><span><strong>Share the link</strong> in the group chat. Friends join with just a name.</span></li>
      <li><span><strong>Add and vote "keen"</strong>, and watch your list re-rank as everyone votes, live.</span></li>
    </ol>
  </section>

  <section aria-labelledby="sample-title">
    <h2 id="sample-title">A few places to start from</h2>
    <ul class="spots spots--sample">
      {sample.map((s) => (
        <li class={`spot spot--${s.kind}`}>
          <SpotPhoto photo={s.photo} name={s.name} kind={s.kind} />
          <span class="tag">{KIND_LABEL[s.kind]}</span>
          <h3>{s.name}</h3>
          <p class="area">{s.area}</p>
          <p>{s.blurb}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
