---
import Base from "../layouts/Base.astro";

// Shown at the link of a group the site admin has archived.
---

<Base title="Group closed · Spots">
  <section class="card notice-page">
    <p class="eyebrow">Group</p>
    <h1>This group has been closed</h1>
    <p>It isn't on Spots any more. If that's a surprise, whoever runs your group can start a new one in a minute.</p>
    <p><a class="btn btn--primary" href="/">Start a group</a></p>
  </section>
</Base>
