        await navigator.clipboard.writeText(url);
        button.classList.add("is-copied");
        setTimeout(() => button.classList.remove("is-copied"), 2000);
      } catch {
        // No clipboard: the link in a box of its own, to copy by hand.
        window.prompt("Copy the invite link", url);
      }
    });
    // Under the invite's button, Show QR code and Add a note each open their
    // panel, one at a time; pressed again, it closes.
    function openMore(id) {
      for (const button of document.querySelectorAll(".share__more-btn")) {
        const on = button.getAttribute("aria-controls") === id;
        button.setAttribute("aria-expanded", String(on));
        document.getElementById(button.getAttribute("aria-controls")).hidden = !on;
        const words = button.querySelector("[data-open]");
        if (words) words.textContent = on ? words.dataset.open : words.dataset.shut;
      }
      if (id === "invite-note") document.querySelector("#invite-note-text")?.focus();
    }
    document.addEventListener("click", (event) => {
      const button = event.target.closest(".share__more-btn");
      if (!button) return;
      openMore(button.getAttribute("aria-expanded") === "true" ? null : button.getAttribute("aria-controls"));
    });
  </script>
