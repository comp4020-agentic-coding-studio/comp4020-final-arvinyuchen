        else if (what === "pick") say(`Everyone's in for ${place}. Pick the time.`, showPlan, "Show");
        else if (what === "changed") say(`${card.querySelector(".plan__changed strong")?.textContent ?? "Someone changed their times"}.`, showPlan, "Show");
