      try {
        const html = await (await fetch(current(), { cache: "no-store" })).text();
        const next = new DOMParser().parseFromString(html, "text/html").querySelector("#explore");
        if (next) {
          explore.innerHTML = next.innerHTML;
          for (const key of ["q", "near"]) {
