                </span>
                <span class="row__body">
                  <strong class="row__title">
                    {a.claimed ? `${a.into.name} says they're ${a.from.name}` : `Two people called ${a.from.name}`}
                  </strong>
                  <span class="row__sub">
                    {a.claimed ? `${a.into.name} joined ${joinedOn(a.into.joinedAt)}, ${a.from.name} ${joinedOn(a.from.joinedAt)}` : `One joined ${joinedOn(a.from.joinedAt)}, one ${joinedOn(a.into.joinedAt)}`}
                  </span>
                </span>
                <span class="row__end same__acts">
                  <form method="post" action={`/api/groups/${group.id}/owner`}>
