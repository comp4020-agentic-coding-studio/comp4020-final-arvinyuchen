      wrapEl.style.setProperty("--fade-top", `${box.top - wrap.top + (pinned ? PIN_BELOW - 5 : 0)}px`);
      wrapEl.style.setProperty("--fade-height", pinned ? `${slot.height + 10}px` : "0.6rem");
      wrapEl.style.setProperty("--fade-solid", pinned ? "45%" : "0%");
      if (!pinned) return;
      askSlot.style.setProperty("--pin-top", `${box.top - wrap.top + PIN_BELOW}px`);
      // (as wide as the cards under it, and the map over it)
      const cards = document.querySelector("#explore").getBoundingClientRect();
