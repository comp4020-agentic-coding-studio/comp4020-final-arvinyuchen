---
import SpotPhoto from "../../components/SpotPhoto.astro";
import Base from "../../layouts/Base.astro";
import { KIND_LABEL, type Kind } from "../../lib/catalogue";
import { groupByLink, listMembers, listPicks, listPlaces } from "../../lib/db";
import { clean, me, signedIn } from "../../lib/me";
import { search } from "../../lib/search";

// The link is the invite. After the owner resets it, the old one still
// brings members back (to the new link), but lets nobody new in.
const byLink = groupByLink(Astro.params.link ?? "");
if (!byLink) return Astro.redirect("/", 303);
const { group } = byLink;
const member = me(Astro.cookies, group.id);
if (!byLink.current) return member ? Astro.redirect(`/g/${group.link}`, 303) : Astro.rewrite("/link-reset");

const account = signedIn(Astro.cookies);
const isOwner = member !== undefined && member.id === group.ownerId;
const members = listMembers(group.id);
const picks = listPicks(group.id);
const places = listPlaces();
const onList = new Set(picks.map((p) => p.place.id));
const kinds = Object.keys(KIND_LABEL) as Kind[];
const shareUrl = new URL(`/g/${group.link}`, Astro.url).href;
const isNew = Astro.url.searchParams.has("new");
const error = Astro.url.searchParams.get("error");
const done = Astro.url.searchParams.get("done");
const DONE: Record<string, string> = {
  renamed: "Renamed.",
  removed: "Removed from the group.",
  merged: "Merged: their keens and places are now one person's.",
  reset: "New invite link made. The old one no longer lets anyone join; send this one instead.",
};

// A search answers with cards only: Explore shows the matching places, best
// first, and the map shows just their pins.
const q = clean(Astro.url.searchParams.get("q"), 200);
const found = q ? await search(q, places) : null;
const shown = found ? found.places : places;

// What the map draws: every place in Explore that has a location. Carried as
// JSON inside #explore, so a live refresh of Explore refreshes the pins too.
const pins = shown
  .filter((p) => p.lat !== null && p.lon !== null)
  .map(({ id, name, kind, area, lat, lon }) => ({ id, name, kind, area, lat, lon }));
const pinsJson = JSON.stringify(pins).replace(/</g, "\\u003c");
---

<Base title={`${group.name} · Spots`}>
  <section class="group-head">
    <p class="eyebrow">Group</p>
    <h1>{group.name}</h1>
    <p class="members">
      {members.length} {members.length === 1 ? "person" : "people"}: {members.map((m) => m.name).join(", ")}
    </p>
    <div class={`share card${isNew ? " share--new" : ""}`}>
      <label for="share-link">{isNew ? "Your group is ready. Send this link to everyone coming:" : "Invite link"}</label>
      <div class="share__row">
        <input id="share-link" value={shareUrl} readonly />
        <button type="button" class="btn" data-copy="#share-link">Copy</button>
      </div>
    </div>
  </section>

  {!member ? (
    <section class="card join" aria-labelledby="join-title">
      <h2 id="join-title">Join {group.name}</h2>
      {error === "name" && <p class="notice" role="alert">Type a name so your friends know it's you.</p>}
      <form method="post" action={`/api/groups/${group.id}/join`} class="stack">
        <input type="hidden" name="link" value={group.link} />
        <label>
          <span>Your name</span>
          <input name="name" required maxlength="40" autocomplete="nickname" value={account?.name} />
        </label>
        <button class="btn btn--primary">Join the group</button>
      </form>
      {!account && (
        <p class="fine passkey-alt" data-passkey-only hidden>
          Been here before on another device?{" "}
          <button type="button" class="linkish" data-passkey="signin" data-group={group.id}>
            Sign in with your passkey
          </button>
          <span class="passkey-msg" aria-live="polite"></span>
        </p>
      )}
    </section>
  ) : (
    <div class="you">
      <p>
        You're in as <strong>{member.name}</strong>
        {isOwner && <span class="owner-tag">owner</span>}.
        {account && member.accountId === account.id && (
          <>
            {" "}Signed in with a passkey · <a href="/me">My groups</a>
          </>
        )}
      </p>
      {member.accountId === null && (
        <div class="keep card" data-passkey-only hidden>
          <div>
            <strong>Be {member.name} on every device</strong>
            <p class="fine">
              Save a passkey (your face, fingerprint or phone PIN) and you can sign in anywhere and find all your
              groups. No password, no email.
            </p>
          </div>
          <div class="keep__actions">
            <button type="button" class="btn btn--primary" data-passkey="register" data-group={group.id}>
              Save a passkey
            </button>
            <button type="button" class="linkish" data-passkey="signin" data-group={group.id}>
              I already have one
            </button>
            <span class="passkey-msg" aria-live="polite"></span>
          </div>
        </div>
      )}
    </div>
  )}

  <section id="list" aria-labelledby="list-title">
    <h2 id="list-title">Our list</h2>
    {picks.length === 0 ? (
      <p class="empty">Nothing on the list yet. Add something from Explore below.</p>
    ) : (
      <ol class="picks">
        {picks.map(({ id, place, addedBy, keen }, i) => {
          const mine = member ? keen.includes(member.name) : false;
          return (
            <li
              id={`pick-${id}`}
              class={`pick spot--${place.kind}${i === 0 && keen.length > 0 ? " pick--top" : ""}`}
              data-place={place.lat !== null ? place.id : undefined}
            >
              <SpotPhoto photo={place.photo} name={place.name} kind={place.kind} small />
              <div class="pick__main">
                <span class="tag">{KIND_LABEL[place.kind]}</span>
                <h3>{place.name}</h3>
                <p class="area">
                  {place.area && `${place.area} · `}added by {addedBy}
                </p>
                <p class="keen-who">{keen.length > 0 ? `Keen: ${keen.join(", ")}` : "No one's keen yet"}</p>
              </div>
              {member && (
                <form method="post" action={`/api/groups/${group.id}/keen`}>
                  <input type="hidden" name="pick" value={id} />
                  <button class={`keen${mine ? " keen--on" : ""}`} aria-pressed={mine ? "true" : "false"}>
                    <span class="keen__count">{keen.length}</span>
                    <span>{mine ? "Keen!" : "I'm keen"}</span>
                  </button>
                </form>
              )}
            </li>
          );
        })}
      </ol>
    )}
  </section>

  <section class="explore-wrap" aria-labelledby="explore-title">
    <div class="explore-head">
      <h2 id="explore-title">Explore</h2>
      <p class="fine">Places every group on Spots has shared, each with a reason it's good.</p>
      <form class="ask" method="get" action={`/g/${group.link}#explore`} role="search" data-search>
        <label for="ask-q" class="sr-only">Describe what you're after</label>
        <input
          id="ask-q"
          name="q"
          value={q}
          maxlength="200"
          autocomplete="off"
          placeholder="Describe it: “cheap dumplings near Dickson”, “a walk with a view”"
        />
        <button class="btn btn--primary">Find</button>
      </form>
      <div class="filters" role="group" aria-label="Show" hidden>
        <button type="button" class="chip chip--on" data-filter="all" aria-pressed="true">All</button>
        {kinds.map((k) => (
          <button type="button" class={`chip chip--${k}`} data-filter={k} aria-pressed="false">
            {KIND_LABEL[k]}
          </button>
        ))}
      </div>
    </div>
    <div class="explore-grid">
      <div id="explore" data-q={q || undefined}>
        <script type="application/json" id="pins" is:inline set:html={pinsJson} />
        {found && (
          <p class="ask-meta">
            {found.places.length > 0 ? "Best matches first" : "Nothing shared fits that yet"}
            {found.near && ` · near ${found.near}`}
            {" · "}
            <a href={`/g/${group.link}#explore`} data-clear-search>Show every place</a>
          </p>
        )}
        <ul class="spots spots--explore">
          {shown.map((p) => (
            <li class={`spot spot--${p.kind}`} data-kind={p.kind} data-place={p.lat !== null ? p.id : undefined}>
              <SpotPhoto photo={p.photo} name={p.name} kind={p.kind} />
              <div class="spot__meta">
                <span class="tag">{KIND_LABEL[p.kind]}</span>
                {p.groups > 0 && (
                  <span class="groups">
                    On {p.groups} {p.groups === 1 ? "list" : "lists"}
                  </span>
                )}
              </div>
              <h3>{p.name}</h3>
              <p class="area">{p.area}</p>
              <p class="why">{p.addedBy === "Spots" ? p.why : `“${p.why}” — ${p.addedBy}`}</p>
              <div class="spot__actions">
                {p.lat !== null && (
                  <button type="button" class="btn btn--small btn--ghost" data-fly={p.id}>
                    Show on map
                  </button>
                )}
                {member &&
                  (onList.has(p.id) ? (
                    <span class="added">On our list</span>
                  ) : (
                    <form method="post" action={`/api/groups/${group.id}/picks`}>
                      <input type="hidden" name="place" value={p.id} />
                      <button class="btn btn--small">Add to our list</button>
                    </form>
                  ))}
              </div>
            </li>
          ))}
        </ul>
      </div>
      <div class="map-wrap">
        <div id="map" role="region" aria-label="Map of the places in Explore"></div>
        <p class="map-credit">
          Map data © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>, tiles by <a href="https://openfreemap.org">OpenFreeMap</a>
        </p>
      </div>
    </div>
  </section>

  {member && (
    <section id="add" class="card add" aria-labelledby="add-title">
      <h2 id="add-title">Share a good place</h2>
      <p class="fine">
        It goes into Explore for every group, so only add somewhere you'd actually send a friend, and say why.
      </p>
      {error === "place" && <p class="notice" role="alert">A place needs a name, a kind and a reason it's good.</p>}
      <div class="finder" hidden>
        <label for="find-q"><span>Find it on the map</span></label>
        <div class="finder__row">
          <input id="find-q" placeholder="e.g. Morning Glory Dickson" autocomplete="off" />
          <button type="button" class="btn" id="find-go">Find</button>
        </div>
        <ul class="finder__results" aria-live="polite"></ul>
      </div>
      <form method="post" action={`/api/groups/${group.id}/places`} class="grid-form" id="add-form">
        <input type="hidden" name="osm" />
        <input type="hidden" name="lat" />
        <input type="hidden" name="lon" />
        <label>
          <span>Name</span>
          <input name="name" required maxlength="80" placeholder="That dumpling place" />
        </label>
        <label>
          <span>Kind</span>
          <select name="kind" required>
            {kinds.map((k) => <option value={k}>{KIND_LABEL[k]}</option>)}
          </select>
        </label>
        <label>
          <span>Suburb</span>
          <input name="area" maxlength="40" placeholder="Dickson" />
        </label>
        <label class="wide">
          <span>Why it's good (required)</span>
          <input name="why" required maxlength="160" placeholder="Best chilli oil in Canberra, and open late" />
        </label>
        <p class="located wide" hidden></p>
        <button class="btn btn--primary wide">Share it and add to our list</button>
      </form>
    </section>
  )}

  {isOwner && (
    <section id="settings" class="card settings" aria-labelledby="settings-title">
      <h2 id="settings-title">Group settings</h2>
      <p class="fine">Only you see this: you started {group.name}.</p>
      {done && DONE[done] && <p class="notice notice--ok" role="status">{DONE[done]}</p>}

      <form method="post" action={`/api/groups/${group.id}/owner`} class="settings__row">
        <input type="hidden" name="action" value="rename" />
        <label class="grow">
          <span>Group name</span>
          <input name="name" required maxlength="60" value={group.name} />
        </label>
        <button class="btn">Rename</button>
      </form>

      <h3>People</h3>
      <ul class="people">
        {members.map((m) => (
          <li>
            <span class="people__name">
              {m.name}
              {m.id === group.ownerId && <span class="owner-tag">owner</span>}
              {m.accountId !== null && <span class="fine"> · passkey</span>}
            </span>
            {m.id !== group.ownerId && (
              <form method="post" action={`/api/groups/${group.id}/owner`} data-confirm={`Remove ${m.name}? Their keens go too.`}>
                <input type="hidden" name="action" value="remove" />
                <input type="hidden" name="member" value={m.id} />
                <button class="btn btn--small btn--ghost">Remove</button>
              </form>
            )}
          </li>
        ))}
      </ul>

      {members.length > 1 && (
        <form method="post" action={`/api/groups/${group.id}/owner`} class="settings__row merge">
          <input type="hidden" name="action" value="merge" />
          <label>
            <span>Same person twice? Merge</span>
            <select name="member" required>
              {members.map((m) => <option value={m.id}>{m.name} (#{m.id})</option>)}
            </select>
          </label>
          <label>
            <span>into</span>
            <select name="into" required>
              {members.map((m, i) => <option value={m.id} selected={i === 0}>{m.name} (#{m.id})</option>)}
            </select>
          </label>
          <button class="btn">Merge</button>
        </form>
      )}

      <h3>Invite link</h3>
      <form
        method="post"
        action={`/api/groups/${group.id}/owner`}
        class="settings__row"
        data-confirm="Make a new invite link? The old one will stop letting anyone new join."
      >
        <input type="hidden" name="action" value="reset" />
        <p class="fine grow">
          If the link got passed around further than you meant, make a new one. Everyone already in stays in.
        </p>
        <button class="btn">Reset invite link</button>
      </form>
    </section>
  )}

  <script is:inline define:vars={{ groupId: group.id }}>
    // Live: anyone joining, picking or voting in this group, or any group
    // sharing a new place, reaches every open page within a moment, with no
    // reload by the viewer. The page asks the server for itself again and
    // swaps in the changed parts, keeping the scroll position, the map and
    // anything typed in the forms.
    const regions = [".group-head h1", ".group-head .members", ".share__row", "#list", "#explore", "#settings .people"];
    // The page as it is now, search included, without one-off notices.
    const current = () => {
      const q = new URLSearchParams(location.search).get("q");
      return location.pathname + (q ? `?q=${encodeURIComponent(q)}` : "");
    };
    let pending = false;
    async function refresh() {
      if (pending) return;
      pending = true;
      try {
        const res = await fetch(current(), { cache: "no-store" });
        // A reset invite link sends members on to the new one: follow it.
        const landed = new URL(res.url);
        if (landed.pathname !== location.pathname) history.replaceState(null, "", landed.pathname + location.search + location.hash);
        const html = await res.text();
        const fresh = new DOMParser().parseFromString(html, "text/html");
        for (const selector of regions) {
          const now = document.querySelector(selector);
          const next = fresh.querySelector(selector);
          if (now && next && now.innerHTML !== next.innerHTML) now.innerHTML = next.innerHTML;
        }
        document.dispatchEvent(new Event("spots:refreshed"));
      } catch {
        location.reload();
      } finally {
        pending = false;
      }
    }
    const source = new EventSource(`/api/events?group=${encodeURIComponent(groupId)}`);
    source.addEventListener("change", refresh);
    source.addEventListener("places", refresh);
    let opened = false;
    source.addEventListener("open", () => {
      if (opened) refresh();
      opened = true;
    });
    // Owner actions that can't be undone ask first.
    document.addEventListener(
      "submit",
      (event) => {
        const ask = event.target.dataset.confirm;
        if (ask && !window.confirm(ask)) {
          event.preventDefault();
          event.stopImmediatePropagation();
        }
      },
      true,
    );
    // A form that posts leaves the page, so the stream closes with it. Search
    // stays on the page: it asks for Explore with the prompt and swaps the
    // answer in, and the map fits itself to the cards that came back.
    document.addEventListener(
      "submit",
      (event) => {
        if (!event.target.matches("[data-search]")) source.close();
      },
      true,
    );
    const ask = document.querySelector("[data-search]");
    const askInput = ask?.querySelector("input[name=q]");
    async function showSearch(q, push) {
      const url = location.pathname + (q ? `?q=${encodeURIComponent(q)}` : "") + "#explore";
      if (push) history.pushState(null, "", url);
      const button = ask.querySelector("button");
      const explore = document.querySelector("#explore");
      button.disabled = true;
      explore.classList.add("is-asking");
      try {
        const html = await (await fetch(current(), { cache: "no-store" })).text();
        const next = new DOMParser().parseFromString(html, "text/html").querySelector("#explore");
        if (next) {
          explore.innerHTML = next.innerHTML;
          if (next.dataset.q) explore.dataset.q = next.dataset.q;
          else delete explore.dataset.q;
        }
        document.dispatchEvent(new Event("spots:refreshed"));
        document.dispatchEvent(new Event("spots:searched"));
      } catch {
        location.href = url;
      } finally {
        button.disabled = false;
        explore.classList.remove("is-asking");
      }
    }
    ask?.addEventListener("submit", (event) => {
      event.preventDefault();
      showSearch(askInput.value.trim(), true);
    });
    document.addEventListener("click", (event) => {
      if (!event.target.closest("[data-clear-search]")) return;
      event.preventDefault();
      askInput.value = "";
      showSearch("", true);
    });
    window.addEventListener("popstate", () => {
      askInput.value = new URLSearchParams(location.search).get("q") ?? "";
      showSearch(askInput.value, false);
    });

    for (const button of document.querySelectorAll("[data-copy]")) {
      button.addEventListener("click", async () => {
        const input = document.querySelector(button.dataset.copy);
        try {
          await navigator.clipboard.writeText(input.value);
          button.textContent = "Copied";
        } catch {
          input.select();
        }
        setTimeout(() => (button.textContent = "Copy"), 1500);
      });
    }
  </script>
  <script>
    import "../../scripts/map";
    import "../../scripts/passkeys";
  </script>
</Base>
