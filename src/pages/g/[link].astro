  </div>
  </div>

  <div id="toast" class="toast" role="status" hidden>
    <span class="toast__text"></span>
    <button type="button" class="toast__undo" hidden>Undo</button>
  </div>

  <script is:inline define:vars={{ groupId: group.id }}>
    // Live: anyone joining, picking or voting in this group, or any group
    // sharing a new place, reaches every open page within a moment, with no
    // reload by the viewer. The page asks the server for itself again and
    // swaps in the changed parts, keeping the scroll position, the map and
    // anything typed in the forms.
    const regions = [".group-head h1", ".group-head .members", ".share__row", ".tabs__n", "#list", "#explore", "#settings .people"];
    // The page as it is now, search included, without one-off notices.
    const current = () => {
      const q = new URLSearchParams(location.search).get("q");
      return location.pathname + (q ? `?q=${encodeURIComponent(q)}` : "");
    };
    // The list is always in rank order: a live refresh re-ranks it, and
    // each card glides from where it was to its new place, so the group
    // sees what moved (PROCESS.md, "Several people voting at once"). For a
    // moment after a move, a keen tap is ignored: it was aimed at whatever
    // card was there before.
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    let movedAt = 0;
    function rerank(now, next) {
      const was = new Map([...now.querySelectorAll(".picks > li")].map((li) => [li.id, li.getBoundingClientRect().top]));
      const order = [...was.keys()].join();
      const focused = document.activeElement?.closest(".picks > li")?.id;
      // (on a wide screen the list scrolls inside its column: stay where you were)
      const scrolled = now.querySelector(".picks")?.scrollTop ?? 0;
      now.innerHTML = next.innerHTML;
      const picks = now.querySelector(".picks");
      if (picks) picks.scrollTop = scrolled;
      // (no entrance replayed: only cards that are new arrive)
      now.dataset.live = "";
      const cards = [...now.querySelectorAll(".picks > li")];
      if (focused) now.querySelector(`#${CSS.escape(focused)} .keen`)?.focus({ preventScroll: true });
      if (cards.map((li) => li.id).join() === order) return;
      movedAt = performance.now();
      if (still.matches) return;
      for (const li of cards) {
        const from = was.get(li.id);
        if (from === undefined) {
          li.animate([{ opacity: 0, transform: "translateY(6px)" }, { opacity: 1, transform: "none" }], { duration: 300, easing: "ease-out" });
          continue;
        }
        const dy = from - li.getBoundingClientRect().top;
        if (dy) li.animate([{ transform: `translateY(${dy}px)` }, { transform: "none" }], { duration: 450, easing: "cubic-bezier(0.2, 0.8, 0.2, 1)" });
      }
    }
    let pending = false;
    let again = false;
    // (a card on its way out finishes leaving before the list is redrawn)
    let leaving = null;
    async function refresh() {
      // A change that lands mid-refresh gets its own pass afterwards, so the
      // last vote is never the one that's missed.
      if (pending) {
        again = true;
        return;
      }
      pending = true;
      try {
        await leaving;
        const res = await fetch(current(), { cache: "no-store" });
        // A reset invite link sends members on to the new one: follow it.
        const landed = new URL(res.url);
        if (landed.pathname !== location.pathname) history.replaceState(null, "", landed.pathname + location.search + location.hash);
        const html = await res.text();
        const fresh = new DOMParser().parseFromString(html, "text/html");
        for (const selector of regions) {
          const now = document.querySelector(selector);
          const next = fresh.querySelector(selector);
          if (!now || !next) continue;
          if (selector === "#list") {
            if (now.innerHTML !== next.innerHTML) rerank(now, next);
          } else if (now.innerHTML !== next.innerHTML) now.innerHTML = next.innerHTML;
        }
        document.dispatchEvent(new Event("spots:refreshed"));
      } catch {
        location.reload();
      } finally {
        pending = false;
        if (again) {
          again = false;
          refresh();
        }
      }
    }
    // A note at the foot of the screen for a moment, with an action in it
    // (Undo) or none.
    const toast = document.querySelector("#toast");
    let toastTimer;
    function say(text, action) {
      clearTimeout(toastTimer);
      toast.querySelector(".toast__text").textContent = text;
      const button = toast.querySelector(".toast__undo");
      button.hidden = !action;
      button.onclick = action ? () => { toast.hidden = true; action(); } : null;
      toast.hidden = false;
      toastTimer = setTimeout(() => (toast.hidden = true), 6000);
    }
    const post = (action, body) => fetch(action, { method: "POST", body, headers: { "x-spots": "in-page" } });
    // A card taken off the list folds away, then the rest close up.
    function fold(li) {
      if (!li || still.matches) return Promise.resolve();
      li.style.overflow = "hidden";
      const h = li.getBoundingClientRect().height;
      return li
        .animate(
          [{ opacity: 1, height: `${h}px` }, { opacity: 0, height: "0px", paddingTop: "0px", paddingBottom: "0px" }],
          { duration: 260, easing: "ease-in", fill: "forwards" },
        )
        .finished.catch(() => {});
    }
    // A keen, or a Remove, posts in the background, so the page (and its
    // order) stays put. If that fails, the form posts the plain way.
    document.addEventListener("submit", async (event) => {
      const form = event.target.closest("[data-keen], [data-remove]");
      if (!form) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      // Busy rather than disabled: disabling would drop the keyboard focus.
      if (form.dataset.busy || performance.now() - movedAt < 450) return;
      // (this handler comes first, so it asks what the owner's confirm would)
      if (form.dataset.confirm && !window.confirm(form.dataset.confirm)) return;
      form.dataset.busy = "true";
      try {
        const res = await post(form.getAttribute("action"), new FormData(form));
        if (form.matches("[data-remove]")) {
          if (res.status === 409) {
            say("That one stays: someone else is keen on it now.");
            await refresh();
            return;
          }
          if (!res.ok) throw new Error(String(res.status));
          const name = form.dataset.remove;
          const li = form.closest("li");
          const place = li?.dataset.placeId;
          leaving = fold(li);
          await refresh();
          leaving = null;
          say(`Took ${name} off the list.`, place && (async () => {
            const body = new FormData();
            body.set("place", place);
            await post(form.getAttribute("action"), body);
            await refresh();
          }));
          return;
        }
        if (!res.ok) throw new Error(String(res.status));
        await refresh();
      } catch {
        form.submit();
      } finally {
        delete form.dataset.busy;
      }
    }, true);
    // Edit and Done switch the list in place (the link loads ?edit without
    // a script).
    document.addEventListener("click", (event) => {
      const toggle = event.target.closest("[data-edit-toggle]");
      if (!toggle) return;
      event.preventDefault();
      const list = document.querySelector("#list");
      const on = !list.hasAttribute("data-editing");
      list.toggleAttribute("data-editing", on);
      const url = new URL(location.href);
      url.searchParams.delete("removed");
      url.searchParams.delete("error");
      if (on) url.searchParams.set("edit", "");
      else url.searchParams.delete("edit");
      history.replaceState(null, "", url.pathname + url.search.replace("edit=", "edit") + url.hash);
    });
    const source = new EventSource(`/api/events?group=${encodeURIComponent(groupId)}`);
    source.addEventListener("change", refresh);
    source.addEventListener("places", refresh);
    let opened = false;
    source.addEventListener("open", () => {
      if (opened) refresh();
      opened = true;
    });
    // Owner actions that can't be undone ask first.
    document.addEventListener(
      "submit",
      (event) => {
        const ask = event.target.dataset.confirm;
        if (ask && !window.confirm(ask)) {
          event.preventDefault();
          event.stopImmediatePropagation();
        }
      },
      true,
    );
    // A form that posts leaves the page, so the stream closes with it. Search
    // stays on the page: it asks for Explore with the prompt and swaps the
    // answer in, and the map fits itself to the cards that came back.
    document.addEventListener(
      "submit",
      (event) => {
        if (!event.target.matches("[data-search], [data-keen], [data-remove]")) source.close();
      },
      true,
    );
    const ask = document.querySelector("[data-search]");
    const askInput = ask?.querySelector("input[name=q]");
    async function showSearch(q, push) {
      const url = location.pathname + (q ? `?q=${encodeURIComponent(q)}` : "") + "#explore";
      if (push) history.pushState(null, "", url);
      const button = ask.querySelector("button");
      const explore = document.querySelector("#explore");
      button.disabled = true;
      explore.classList.add("is-asking");
      try {
        const html = await (await fetch(current(), { cache: "no-store" })).text();
        const next = new DOMParser().parseFromString(html, "text/html").querySelector("#explore");
        if (next) {
          explore.innerHTML = next.innerHTML;
          if (next.dataset.q) explore.dataset.q = next.dataset.q;
          else delete explore.dataset.q;
        }
        document.dispatchEvent(new Event("spots:refreshed"));
        document.dispatchEvent(new Event("spots:searched"));
      } catch {
        location.href = url;
      } finally {
        button.disabled = false;
        explore.classList.remove("is-asking");
      }
    }
    ask?.addEventListener("submit", (event) => {
      event.preventDefault();
      showSearch(askInput.value.trim(), true);
    });
    document.addEventListener("click", (event) => {
      if (!event.target.closest("[data-clear-search]")) return;
      event.preventDefault();
      askInput.value = "";
      showSearch("", true);
    });
    window.addEventListener("popstate", () => {
      // (only when the search itself changed, not on going back a tab)
      const q = new URLSearchParams(location.search).get("q") ?? "";
      if (q === (document.querySelector("#explore")?.dataset.q ?? "")) return;
      askInput.value = q;
      showSearch(q, false);
    });

    // Tabs: one part of the group at a time (Our list, Explore, Share a
    // place, Settings), the open one in the URL's #, so a reload, the back
    // button or a form that lands on #settings opens the right one. On a
    // wide screen Our list is always there in the left column, so the tabs
    // choose what's beside it: Explore (with the map), Share or Settings.
    const page = document.querySelector(".group-page");
    const tabLinks = [...document.querySelectorAll(".tabs a[data-tab]")];
    const panels = [...document.querySelectorAll("[data-panel]")];
    const wide = matchMedia("(min-width: 1180px)");
    const tabOf = (hash) => {
      if (/^#(explore|explore-section)$/.test(hash)) return "explore";
      if (hash === "#add") return "add";
      if (hash === "#settings" && document.querySelector("#settings")) return "settings";
      return "list";
    };
    let tab = tabOf(location.hash);
    function show(next, scroll) {
      tab = next;
      page.dataset.tab = tab;
      const beside = wide.matches && tab === "list" ? "explore" : tab;
      for (const panel of panels) {
        const kind = panel.dataset.panel;
        panel.hidden = !(kind === beside || (wide.matches && kind === "list"));
      }
      for (const a of tabLinks) {
        if (a.dataset.tab === beside) a.setAttribute("aria-current", "page");
        else a.removeAttribute("aria-current");
      }
      // (a map shown again takes its size)
      window.dispatchEvent(new Event("resize"));
      // The tab opens at its top, under the tabs, never scrolled half way.
      const top = document.querySelector(".group-head").getBoundingClientRect().bottom + scrollY;
      if (scroll && scrollY > top) scrollTo({ top, behavior: "instant" });
    }
    page.classList.add("is-tabbed");
    show(tab, false);
    // (a link to one card, like a vote without the script, still lands on it)
    try {
      if (location.hash) document.querySelector(location.hash)?.scrollIntoView();
    } catch {
      // (a # that isn't an id)
    }
    wide.addEventListener("change", () => show(tab, false));
    window.addEventListener("popstate", () => show(tabOf(location.hash), true));
    function go(next, hash) {
      if (location.hash !== hash) history.pushState(null, "", location.pathname + location.search + hash);
      show(next, true);
    }
    document.addEventListener("click", (event) => {
      const link = event.target.closest("a[data-tab]");
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      go(link.dataset.tab, link.hash);
    });
    // A tap on a place in the list shows it on the map, which on a narrow
    // screen is Explore's: open that first (src/scripts/map.ts then flies).
    document.addEventListener(
      "click",
      (event) => {
        if (wide.matches || tab !== "list") return;
        if (event.target.closest("button, a, form, input, select, label")) return;
        if (event.target.closest("#list [data-place]")) go("explore", "#explore-section");
      },
      true,
    );

    // Where the invite opens over the page (beside the name, wider than a
    // phone), a click outside it or Escape closes it, as a popover would.
    const inviteBox = document.querySelector("#invite");
    const floating = () => inviteBox?.open && getComputedStyle(inviteBox.querySelector(".share")).position === "absolute";
    document.addEventListener("click", (event) => {
      if (floating() && !inviteBox.contains(event.target)) inviteBox.open = false;
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !floating()) return;
      inviteBox.open = false;
      inviteBox.querySelector("summary").focus();
    });

    // The link copies with one tap where there's a clipboard; elsewhere it
    // stays a field to select it in. Delegated, since a reset invite link
    // swaps the share row in live.
    if (navigator.clipboard?.writeText) document.documentElement.classList.add("can-copy");
    document.addEventListener("click", async (event) => {
      const button = event.target.closest("[data-copy]");
      if (!button) return;
      const input = document.querySelector(button.dataset.copy);
      const say = button.querySelector(".share__do");
      try {
        await navigator.clipboard.writeText(input.value);
        button.classList.add("is-copied");
        say.textContent = "Copied";
        setTimeout(() => {
          button.classList.remove("is-copied");
          say.textContent = "Copy link";
        }, 2000);
      } catch {
        // No clipboard after all: back to the field, with the link selected.
        document.documentElement.classList.remove("can-copy");
        input.focus();
        input.select();
      }
    });

    // The system share sheet, where there is one (phones, Safari, Edge): it
    // reaches every app on the device, Instagram and WeChat included, which
    // no web link can. Elsewhere the button stays hidden and the links do.
    if (navigator.share) document.documentElement.classList.add("can-share");
    document.addEventListener("click", async (event) => {
      const button = event.target.closest("[data-share]");
      if (!button) return;
      const url = document.querySelector("#share-link").value;
      try {
        await navigator.share({ title: button.dataset.title, text: button.dataset.text, url });
      } catch {
        // Closing the sheet without picking an app is not an error worth showing.
      }
    });
  </script>
  </>
