    // Delegated, since a live refresh swaps the plan cards.
    const menus = () => document.querySelectorAll(".plan__menu[open]");
    const items = (menu) => [...menu.querySelectorAll('[role="menuitem"]')];
    document.addEventListener(
      "toggle",
      (event) => {
