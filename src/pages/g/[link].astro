---
import CityPhoto from "../../components/CityPhoto.astro";
import KindIcon from "../../components/KindIcon.astro";
import BusySheet from "../../components/BusySheet.astro";
import MiniMap from "../../components/MiniMap.astro";
import NearPlan from "../../components/NearPlan.astro";
import NoPasskey from "../../components/NoPasskey.astro";
import PlanCard from "../../components/PlanCard.astro";
import PlanExact from "../../components/PlanExact.astro";
import PlanStart from "../../components/PlanStart.astro";
import SpotPhoto from "../../components/SpotPhoto.astro";
import TalkSheet from "../../components/TalkSheet.astro";
import Base from "../../layouts/Base.astro";
import { KIND_LABEL, type Kind } from "../../lib/catalogue";
import {
  canRemovePick,
  claimable,
  groupByLink,
  listMembers,
  listPicks,
  listPlaces,
  mergeAsks,
  newcomers,
  NOTE_MAX,
  pendingClaim,
  type Place,
} from "../../lib/db";
import { renderSVG } from "uqr";
import { nearPlan, nearText } from "../../lib/outing";
import { PIN_ICON } from "../../lib/outing-icons";
import { clean, me, signedIn } from "../../lib/me";
import { currentPlan, pastPlans, planView, stopNames } from "../../lib/plans";
import { search } from "../../lib/search";
import { talkCounts, thread } from "../../lib/talk";
import { dayParts, formatDay, formatMinute } from "../../lib/when";

// The link is the invite. After the owner resets it, the old one still
// brings members back (to the new link), but lets nobody new in.
const byLink = groupByLink(Astro.params.link ?? "");
// (a link that was never a group says so, rather than landing on the home page)
if (!byLink) return Astro.rewrite("/404");
if (byLink === "closed") return Astro.rewrite("/group-closed");
const { group } = byLink;
const member = me(Astro.cookies, group.id);
if (!byLink.current) return member ? Astro.redirect(`/g/${group.link}`, 303) : Astro.rewrite("/link-reset");

const account = signedIn(Astro.cookies);
const isOwner = member !== undefined && member.id === group.ownerId;
const members = listMembers(group.id);
const ownerName = members.find((m) => m.id === group.ownerId)?.name ?? "the owner";
// The same person twice (src/lib/db.ts): for the owner, who's asked to be
// merged; for someone who said who they were, that it's waiting on the
// owner; and for someone joining, who they could say they were.
const asks = isOwner ? mergeAsks(group) : [];
const claimed = member && !isOwner ? pendingClaim(group, member) : undefined;
const before = member ? [] : claimable(group);
const joinedOn = (sqlite: string) =>
  new Date(`${sqlite.replace(" ", "T")}Z`).toLocaleDateString("en-AU", { day: "numeric", month: "short" });
const picks = listPicks(group.id);
const places = listPlaces();
const onList = new Set(picks.map((p) => p.place.id));
const kinds = Object.keys(KIND_LABEL) as Kind[];
const shareUrl = new URL(`/g/${group.link}`, Astro.url).href;
const isNew = Astro.url.searchParams.has("new");
// The invite goes person to person, never to a public feed: whoever holds the
// link can join, so there's no Facebook post or X button (see CLAUDE.md). The
// link to copy works everywhere; where there's a share sheet (a phone, Safari)
// Share… opens it, with Messages, WhatsApp, Instagram, WeChat and the rest.
const invite = `Join ${group.name} on Spots: we're picking places to go together.`;
// The link as a QR code for phones round the table, drawn here, nothing
// fetched (#119); shown only on a computer, by the stylesheet.
const qr = renderSVG(shareUrl, { border: 1 });
// Who joined since you last looked (#120), until you dismiss it: "Mia joined
// Saturday crew", "Mia and Leo joined…", "Mia, Leo and 3 others joined…".
const joined = member ? newcomers(group.id, member.id) : [];
const joinedNames = joined.map((j) => j.name);
const joinedText = `${
  joinedNames.length > 3
    ? `${joinedNames.slice(0, 2).join(", ")} and ${joinedNames.length - 2} others`
    : `${joinedNames.length > 1 ? `${joinedNames.slice(0, -1).join(", ")} and ` : ""}${joinedNames.at(-1)}`
} joined ${group.name}`;
const error = Astro.url.searchParams.get("error");
const done = Astro.url.searchParams.get("done");
const DONE: Record<string, string> = {
  renamed: "Renamed.",
  noted: "Note saved. It's what people see above the join form.",
  removed: "Removed from the group.",
  merged: "Merged: their keens and places are now one person's.",
  kept: "Kept apart: they're two people.",
  reset: "New invite link made. The old one no longer lets anyone join; send this one instead.",
};

// A search answers with cards only: Explore shows the matching places, best
// first, and the map shows just their pins.
const q = clean(Astro.url.searchParams.get("q"), 200);

// Our list in Edit mode (?edit, or the Edit button): Remove where this
// member may take a place off, in place of the keen button. After a plain
// form's remove, the place that went, to put back.
const editing = Astro.url.searchParams.has("edit");
const removedId = Number(Astro.url.searchParams.get("removed"));
const removed = removedId ? places.find((p) => p.id === removedId && !onList.has(p.id)) : undefined;
const found = q ? await search(q, places) : null;
// Unsearched, Explore leads with what groups have put on lists and what
// members have shared; then the starter places take turns by kind, so the
// first page shows every kind, not a page of food.
const turns = (all: Place[]) => {
  const lead = all.filter((p) => p.groups > 0 || p.addedBy !== "Spots");
  const byKind = kinds.map((k) => all.filter((p) => p.kind === k && !lead.includes(p)));
  const mixed = Array.from({ length: Math.max(0, ...byKind.map((b) => b.length)) }, (_, i) => byKind.map((b) => b[i]).filter(Boolean)).flat();
  return [...lead, ...mixed];
};
const shown = found ? found.places : turns(places);

// What the map draws: every place in Explore that has a location, with its
// photo for the card the map opens on it (src/scripts/map.ts). Carried as
// JSON inside #explore, so a live refresh of Explore refreshes the pins too.
const pins = shown
  .filter((p) => p.lat !== null && p.lon !== null)
  .map(({ id, name, kind, area, lat, lon, photo }) => ({ id, name, kind, area, lat, lon, photo: photo?.src ?? null }));
const pinsJson = JSON.stringify(pins).replace(/</g, "\\u003c");

// Before joining, the link shows a preview and nothing more: who's in, who
// started it, and the first few places, oldest first so the order says
// nothing about votes. The list, the keens and Explore are for members.
const owner = members.find((m) => m.id === group.ownerId);
const preview = [...picks].sort((a, b) => a.id - b.id).slice(0, 3);
// The note's words, each its own span so they can arrive one after another.
const noteWords = group.note?.split(" ") ?? [];


// Each member's initial in a colour of its own, the same on every visit.
const hue = (name: string) => [...name].reduce((h, c) => (h * 31 + c.codePointAt(0)!) % 360, 17);

// Who's in, on the group's panel: the owner first, then you, then the rest
// in the order they joined. Up to six fit a row; more, and it's five and
// a "+N more" face that unfolds them all.
const firstOf = (id: number) => (id === group.ownerId ? 0 : id === member?.id ? 1 : 2);
const crew = [...members].sort((a, b) => firstOf(a.id) - firstOf(b.id));
const crewMore = crew.length > 6 ? crew.length - 5 : 0;
const crown = "M1.5 5.2 5 8l3-5 3 5 3.5-2.8-1.3 7.3H2.8z";

// The group's plan (src/lib/plans.ts), for members only: the one on now,
// and those behind it. What it needs from this member puts a dot on Our
// list's tab and rings its card: their busy times, or (the owner) the
// time to pick once everyone's in, or a look at who changed theirs.
const plan = member ? currentPlan(group.id) : undefined;
const view = plan && member ? planView(plan, members, member, group.ownerId) : undefined;
const past = member ? pastPlans(group.id) : [];
const needs = !view
  ? ""
  : !plan!.set && view.mine === null
    ? "answer"
    : isOwner && !plan!.set && view.everyoneIn
      ? "pick"
      : isOwner && view.changed
        ? "changed"
        : "";
const planParam = Astro.url.searchParams.get("plan");

// Talk (src/lib/talk.ts): a thread on each place on the list, for members.
// Without a script, ?talk=<place> opens one (and ?before=<message> pages
// back), which marks it read, so it's read before the counts are.
const talkId = Number(Astro.url.searchParams.get("talk"));
const talkPick = member && talkId ? picks.find((p) => p.place.id === talkId) : undefined;
const talkThread = talkPick && member ? thread(group, member, talkId, { before: Number(Astro.url.searchParams.get("before")) || undefined }) : undefined;
const talkOpen = talkPick && talkThread ? { placeId: talkId, name: talkPick.place.name, thread: talkThread } : null;
const talk = member ? talkCounts(group.id, member) : new Map<number, { total: number; unread: number }>();
const talkNew = [...talk.values()].reduce((sum, t) => sum + t.unread, 0);
const bubble = `<path d="M10 3.2c-4.2 0-7.3 2.7-7.3 6 0 1.9 1 3.6 2.6 4.7-.1 1-.6 2-1.4 2.7 1.6 0 3-.6 4-1.4.7.2 1.4.2 2.1.2 4.2 0 7.3-2.7 7.3-6.1S14.2 3.2 10 3.2Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>`;
const PLAN_ERROR: Record<string, string> = {
  "plan-exists": "There's a plan on already. Call it off first to start another.",
  "plan-gone": "That plan has changed since this page loaded: here it is now.",
  "plan-set": "That time doesn't fit the plan's hours. Pick one of the starts offered.",
  "plan-change": "That day or those hours don't work: a day from today on, hours between 6am and midnight.",
};
// (on each stop's row, after its suburb: the day, the time once set, and
// which stop it is when there are several: "Thu 29, 1pm, stop 1")
const planLine = (placeId: number) => {
  const at = plan ? plan.stops.findIndex((s) => s.id === placeId) : -1;
  if (!plan || at < 0) return "";
  const day = `${dayParts(plan.day).weekday} ${dayParts(plan.day).date}`;
  const when = plan.set ? `${day}, ${formatMinute(plan.set.start)}` : day;
  return plan.stops.length > 1 ? `${when}, stop ${at + 1}` : when;
};
// "Near your plan" (src/components/NearPlan.astro): with a plan on, ?near
// puts Explore's places nearest its stops first, each saying how far, and
// ?kind opens it on that kind's chip ("Find food nearby" on the card). No
// plan, or none of its stops on the map, and Explore is as it always is.
const planStops = (plan?.stops ?? [])
  .map((s) => places.find((p) => p.id === s.id))
  .filter((p): p is Place & { lat: number; lon: number } => p !== undefined && p.lat !== null && p.lon !== null);
const nearOn = planStops.length > 0 && Astro.url.searchParams.has("near");
const near = nearOn ? nearPlan(shown, planStops) : null;
const listed = near ? near.map((n) => n.place) : shown;
const nearById = new Map(near?.map((n) => [n.place.id, nearText(n)]));
const nearLine = (id: number) => nearById.get(id) ?? null;
const startKind = ((k) => (k in KIND_LABEL ? (k as Kind) : "all"))(Astro.url.searchParams.get("kind") ?? "");
// Explore's cards come a page at a time, of the kind chosen (?kind), with
// "Show more" for the next (?more, how many to show), so a refresh redraws
// a page of cards, never hundreds. The map still has every place. ?at puts
// one place's card first when it isn't on the page, for the map's callout
// to bring it into view.
const PAGE = 24;
const ofKind = startKind === "all" ? listed : listed.filter((p) => p.kind === startKind);
const pageOf = ofKind.slice(0, Math.ceil((Number(Astro.url.searchParams.get("more")) || PAGE) / PAGE) * PAGE);
const at = ofKind.find((p) => p.id === Number(Astro.url.searchParams.get("at")) && !pageOf.includes(p));
const paged = at ? [at, ...pageOf] : pageOf;
const left = ofKind.length - paged.length;
const moreHref = (() => {
  const keep = new URLSearchParams();
  if (q) keep.set("q", q);
  if (nearOn) keep.set("near", "");
  if (startKind !== "all") keep.set("kind", startKind);
  if (at) keep.set("at", String(at.id));
  keep.set("more", String(pageOf.length + PAGE));
  return `/g/${group.link}?${keep.toString().replace(/near=(&|$)/, "near$1")}#explore`;
})();
const calendar = `<rect x="3" y="4.5" width="14" height="12.5" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M3 8.5h14M7 2.8v3M13 2.8v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>`;
---

<Base
  title={`${group.name} · Spots`}
  share={{
    title: `Join ${group.name} on Spots`,
    description: "A shared list of places to go, picked together. Join with your name and a passkey: no app, no password.",
    url: shareUrl,
  }}
>
  {!member ? (
  <section class="welcome" aria-labelledby="welcome-title">
    <div class="card welcome__card">
      <div class="welcome__hero">
        <CityPhoto class="welcome__photo" sizes="(min-width: 34rem) 32rem, 100vw" first />
        <header class="welcome__head">
          <p class="eyebrow">You're invited to</p>
          <h1 id="welcome-title">{group.name}</h1>
          <p class="members">
            <span class="faces" aria-hidden="true">
              {members.slice(0, 6).map((m) => (
                <span class="face" style={`--hue: ${hue(m.name)}`}>{[...m.name][0]?.toUpperCase()}</span>
              ))}
            </span>
            <span>
              {owner && <>{owner.name} started it · </>}
              {members.length} {members.length === 1 ? "person" : "people"}: {members.map((m) => m.name).join(", ")}
            </span>
          </p>
        </header>
      </div>

      {/* The card's modules, top to bottom: the photo and who's in it (above),
          the owner's message, then the one thing to do, on its own tinted
          footer. */}
      {group.note && (
        <div class="welcome__module">
          <figure class="welcome__note">
            <figcaption>
              {owner && (
                <span class="face" style={`--hue: ${hue(owner.name)}`} aria-hidden="true">
                  {[...owner.name][0]?.toUpperCase()}
                </span>
              )}
              <span class="welcome__from">
                {owner ? <><strong>{owner.name}</strong> sent you a message</> : "A message for you"}
              </span>
            </figcaption>
            <blockquote>{noteWords.map((w, i) => <>{i > 0 && " "}<span style={`--w: ${i}`}>{w}</span></>)}</blockquote>
          </figure>
        </div>
      )}
      <div class="welcome__module welcome__module--actions">
        {/* Everyone joins as an account. Signed in, it's one button; signed
            out, sending the form makes the account first (your name and a
            passkey, src/scripts/passkeys.ts), or "Sign in" finds the one
            you have and then sends it. */}
        <form
          id="join"
          method="post"
          action={`/api/groups/${group.id}/join`}
          class="stack welcome__form"
          data-account={account ? undefined : "new"}
          data-passkey-only={account ? undefined : ""}
        >
          <input type="hidden" name="link" value={group.link} />
          {error === "account" && (
            <p class="notice" role="alert">Joining needs an account: your name, email and a passkey.</p>
          )}
          {account ? (
            <>
              <p class="welcome__label">Join the group</p>
              <p class="welcome__field welcome__as">
                <span class="face welcome__you" aria-hidden="true" style={`--hue: ${hue(account.name)}`}>
                  {[...account.name][0]?.toUpperCase()}
                </span>
                <span>as <strong>{account.name}</strong></span>
              </p>
            </>
          ) : (
            <>
              <label for="join-name" class="welcome__label">Join the group<span class="sr-only">: your first name</span></label>
              <div class="welcome__field">
                {/* The face you'll have in the group, filled in as you type (src/scripts/welcome.ts). */}
                <span class="face welcome__you" aria-hidden="true"></span>
                <input id="join-name" name="name" required maxlength="40" autocomplete="nickname" placeholder="Your first name" data-hint="Type your name, so the group knows it's you." />
              </div>
              <label for="join-email" class="sr-only">Your email, to get back in if you lose your passkey</label>
              <div class="welcome__field welcome__field--email">
                <input id="join-email" name="email" type="email" required maxlength="254" autocomplete="email" placeholder="Your email" data-hint="Type your email: it gets you back in if you lose your passkey." />
              </div>
            </>
          )}
          {before.length > 0 && (
            <details class="welcome__again">
              <summary>Been in this group before, on a device you lost?</summary>
              <fieldset>
                <legend>Who were you?</legend>
                <div class="welcome__was">
                  {before.map((m) => (
                    <label class="welcome__was-one">
                      <input type="radio" name="was" value={m.id} />
                      <span class="face" aria-hidden="true" style={`--hue: ${hue(m.name)}`}>{[...m.name][0]?.toUpperCase()}</span>
                      <span>{m.name}</span>
                    </label>
                  ))}
                </div>
                <p class="fine">{ownerName} confirms it's you, and your keens and places come back.</p>
              </fieldset>
            </details>
          )}
          <button class="btn btn--primary welcome__join">
            <span>Join {group.name}</span>
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
              <path d="M4 10h11M11 5.5 15.5 10 11 14.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <span class="passkey-msg" aria-live="polite"></span>
          {!account && (
            <p class="fine passkey-alt">
              You'll save a passkey for Spots: your face, fingerprint or phone PIN. Your email gets you back in if
              you lose it. Have one?{" "}
              <button type="button" class="linkish" data-passkey="signin" data-then="#join">Sign in</button>, or on a new
              device, <a href={`/add-device?next=${encodeURIComponent(`/g/${group.link}`)}`}>add it with a code</a>.
            </p>
          )}
        </form>
        {!account && <NoPasskey to="join" />}
      </div>
    </div>

    <section class="card welcome__card welcome__listcard" id="on-the-list" aria-labelledby="on-the-list-title">
      <div class="welcome__content">
        <div class="welcome__list">
          <h2 id="on-the-list-title" class="welcome__label">On the list so far</h2>
          {preview.length > 0 ? (
            <>
              <MiniMap
                pins={preview.map(({ place }, i) => ({
                  n: i + 1,
                  name: place.name,
                  area: place.area,
                  kind: place.kind,
                  lat: place.lat,
                  lon: place.lon,
                }))}
              />
              <ol class="welcome__stops">
                {preview.map(({ place }, i) => (
                  <li class={`welcome__stop spot--${place.kind}`}>
                    <span class="welcome__num" aria-hidden="true">{i + 1}</span>
                    <strong>{place.name}</strong>
                    <span class="welcome__where">{place.area ?? KIND_LABEL[place.kind]}</span>
                  </li>
                ))}
              </ol>
            </>
          ) : (
            <p class="fine">Nothing yet: you could add the first place.</p>
          )}
        </div>
      </div>
    </section>
  </section>
  ) : (
  <>
  <div class="group-page">
  {/* The group's own column: who and inviting, the tabs, and Our list. On a
      wide screen it stands on the left beside Explore and the map. */}
  <div class="group-side">
  {/* Who joined since you last looked, until you dismiss it: a slim notice
      at the top of the group's column, since there's no push it waits
      here, across visits, and arrives live (#120). */}
  <div class="joined-slot">
    {joined.length > 0 && (
      <form class="joined" method="post" action={`/api/groups/${group.id}/seen`} data-seen role="status">
        <span class="joined__dot" aria-hidden="true"></span>
        <span class="joined__text">{joinedText}</span>
        <button class="joined__close" aria-label="Dismiss">
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="m4 4 8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
        </button>
      </form>
    )}
    {asks.length > 0 && (
      <a class="joined" href="#settings" data-tab="settings">
        <span class="joined__dot joined__dot--ask" aria-hidden="true"></span>
        <span class="joined__text">
          {asks.length > 1
            ? `${asks.length} people may have joined twice. Same person?`
            : asks[0].claimed
              ? `${asks[0].into.name} says they're ${asks[0].from.name} from before. Same person?`
              : `Two ${asks[0].into.name}s here. Same person?`}
        </span>
      </a>
    )}
    {claimed && (
      <p class="joined" role="status">
        <span class="joined__dot joined__dot--ask" aria-hidden="true"></span>
        <span class="joined__text">You said you're {claimed.name} from before: once {ownerName} confirms, their keens and places are yours.</span>
      </p>
    )}
  </div>
  <section class="group-head group-head--split">
    <div class="group-head__title">
      <h1>{group.name}</h1>
      {/* The time set for the group's plan, on every tab's header. */}
      <p class="next-up-slot">
        {plan?.set && view?.set && (
          <a class="next-up" href={`#plan-${plan.id}`} data-tab="list">
            <span class="next-up__cal" aria-hidden="true"><svg viewBox="0 0 20 20" width="15" height="15" set:html={calendar} /></span>
            <span class="next-up__text">
              {formatDay(plan.day)}, {formatMinute(plan.set.start)} · {stopNames(plan.stops, 1)}
              <span> · {view.set.busy.length === 0 && view.set.unknown.length === 0 ? "everyone's free" : `${view.set.free.length} free`}</span>
            </span>
          </a>
        )}
      </p>
      {/* Who's in, as faces with names: the owner's has a crown, yours a
          ring. Past six, the last face is "+N more", the summary of a
          <details>, so it unfolds everyone without a script, and folds
          them again as "less". The <details> sits outside what a live
          refresh redraws (the count, the faces, the "+N"), so it stays
          open. How many and whose group is said to a screen reader. */}
      <div class="who">
        <p class="who__count sr-only">
          {members.length} {members.length === 1 ? "person" : "people"}{owner && `, ${owner.name}'s group`}
        </p>
        <ul class="who__grid" role="list">
          {crew.map((m, i) => {
            const mine = m.id === member.id;
            const owns = m.id === group.ownerId;
            return (
              <li class={`who__cell${i >= 5 && crewMore ? " who__cell--extra" : ""}`}>
                <span class={`face${mine ? " is-you" : ""}`} style={`--hue: ${hue(m.name)}`} aria-hidden="true">
                  {[...m.name][0]?.toUpperCase()}
                  {owns && (
                    <span class="crown"><svg viewBox="0 0 16 16"><path fill="currentColor" d={crown} /></svg></span>
                  )}
                  {mine && <span class="who__you">YOU</span>}
                </span>
                <span class={`who__name${mine ? " is-you" : ""}${owns ? " is-owner" : ""}`}>
                  {m.name}
                  {(owns || mine) && <span class="sr-only"> ({[owns && "owner", mine && "you"].filter(Boolean).join(", ")})</span>}
                </span>
              </li>
            );
          })}
        </ul>
        <details class="who__toggle">
          <summary class="who__cell">
            <span class="who__fold">
              <span class="face face--more" aria-hidden="true">+{crewMore}</span>
              <span class="who__name" aria-hidden="true">more</span>
              <span class="sr-only">Show all {members.length} people</span>
            </span>
            <span class="who__unfold">
              <span class="face face--more" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="16" height="16"><path d="M3.5 10 8 5.5l4.5 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
              <span class="who__name" aria-hidden="true">less</span>
              <span class="sr-only">Show fewer</span>
            </span>
          </summary>
        </details>
      </div>
    </div>
    {/* (on a wide screen, where this is the group's panel: the home page's
        Canberra across its top) */}
    <div class="group-head__photo" aria-hidden="true">
      <CityPhoto class="group-head__img" sizes="24rem" lazy />
    </div>
    {/* The invite, folded behind a button: it's needed once, then every
        visit would open on it. Open by itself while the group is new or
        still just its owner. A <details>, so it opens without a script. */}
    <details class="invite" id="invite" open={isNew || members.length === 1}>
      <summary class="btn invite__open">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <path d="M8 9.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM2.5 16.5c.6-2.8 2.8-4.5 5.5-4.5s4.9 1.7 5.5 4.5M15.5 6.5v5M13 9h5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
        Invite friends
      </summary>
      {/* The invite as one panel and one button: on a touch screen with a
          share sheet it opens the sheet (which has Copy too), elsewhere it
          copies the link. Never a public feed
          (CLAUDE.md). */}
      <div class={`share card${isNew ? " share--new" : ""}`}>
        <h2 class="share__title">{isNew ? "Your group is ready" : `Invite friends to ${group.name}`}</h2>
        <div class="share__row">
          <button type="button" class="share__copy" id="share-link" data-invite={shareUrl} data-title={`Join ${group.name} on Spots`} data-text={invite}>
            <span class="share__glyph" aria-hidden="true">
              <svg class="share__chain" viewBox="0 0 24 24" width="20" height="20"><path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1 1M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <svg class="share__tick" viewBox="0 0 24 24" width="20" height="20"><path d="m5.5 12.5 4.2 4.2L18.5 8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
            <span class="share__words">
              <span class="share__do" aria-live="polite">
                <span class="share__say share__say--copy">Copy invite link</span>
                <span class="share__say share__say--sheet">Share invite</span>
                <span class="share__say share__say--done">Copied</span>
              </span>
            </span>
            <svg class="share__dup" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect x="8.5" y="8.5" width="11" height="11" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M15.5 8.5v-2a2 2 0 0 0-2-2h-7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
            <svg class="share__out" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 3.5v11M8 7.5l4-4 4 4M7 11H6a1.5 1.5 0 0 0-1.5 1.5v6A1.5 1.5 0 0 0 6 20h12a1.5 1.5 0 0 0 1.5-1.5v-6A1.5 1.5 0 0 0 18 11h-1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
        </div>
        {/* Two quieter things under it, each a small link that opens its
            panel: the link as a QR code for phones round the table (a
            computer only; #119), and for the owner, the note to the people
            they invite (#118). Outside what a refresh redraws, so an open
            panel or a half-typed note stays. */}
        <div class="share__more">
          <button type="button" class="share__more-btn share__more-btn--qr" aria-expanded="false" aria-controls="invite-qr">
            <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M3.5 3.5h5v5h-5zM11.5 3.5h5v5h-5zM3.5 11.5h5v5h-5zM11.5 11.5h2v2h-2zM14.5 14.5h2v2h-2zM11.5 15.5h1M15.5 11.5h1" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>
            <span data-shut="Show QR code" data-open="Hide QR code">Show QR code</span>
          </button>
          {isOwner && (
            <button type="button" class="share__more-btn" aria-expanded="false" aria-controls="invite-note">
              <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M10 3.5c-3.9 0-7 2.5-7 5.6 0 1.8 1 3.4 2.7 4.4-.1.9-.6 1.7-1.2 2.3 1.4.1 2.7-.4 3.6-1.2.6.1 1.2.2 1.9.2 3.9 0 7-2.5 7-5.7s-3.1-5.6-7-5.6Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>
              <span class="share__note-act">{group.note ? "Edit note" : "Add a note"}</span>
            </button>
          )}
        </div>
        <figure class="share__qr" id="invite-qr" hidden>
          <span class="share__code" role="img" aria-label="QR code of the invite link" set:html={qr} />
          <figcaption>Scan with a phone's camera to join</figcaption>
        </figure>
        {isOwner && (
          <form class="share__note-form ask" id="invite-note" hidden method="post" action={`/api/groups/${group.id}/owner`} data-note>
            <input type="hidden" name="action" value="note" />
            <label for="invite-note-text" class="sr-only">A note for the people you invite, the first thing they see</label>
            <input id="invite-note-text" name="note" maxlength={NOTE_MAX} value={group.note ?? ""} placeholder="Where are we going Friday?" enterkeyhint="done" autocomplete="off" />
            <button class="btn">Save</button>
          </form>
        )}
      </div>
    </details>
  </section>

  {/* One part of the group at a time: tabs, by the script below. Without
      it they're links down the page, and every part is there. */}
  {/* (with a glyph each, for when they're the phone's tab bar) */}
  <nav class="section-nav tabs" aria-label="Group">
    <a href="#list" data-tab="list">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <span>Our list</span> <span class="tabs__n">{picks.length}</span>
      <span class="tabs__flag">
        {(needs || talkNew > 0) && (
          <span class="tabs__dot"><span class="sr-only">: {[needs && "the plan needs you", talkNew > 0 && `${talkNew} new in Talk`].filter(Boolean).join(", ")}</span></span>
        )}
      </span>
    </a>
    <a href="#explore-section" data-tab="explore">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M9 4 3.5 6v14L9 18l6 2 5.5-2V4L15 6 9 4Zm0 0v14m6-12v14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <span>Explore</span>
    </a>
    <a href="#add" data-tab="add">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Zm0-13.5v5m-2.5-2.5h5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <span>Share</span>
    </a>
    {isOwner && (
      <a href="#settings" data-tab="settings">
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm7.4-3a7.4 7.4 0 0 0-.1-1.2l2-1.6-2-3.4-2.4.9a7.5 7.5 0 0 0-2-1.2L14.5 3h-5l-.4 2.5a7.5 7.5 0 0 0-2 1.2l-2.4-.9-2 3.4 2 1.6a7.4 7.4 0 0 0 0 2.4l-2 1.6 2 3.4 2.4-.9c.6.5 1.3.9 2 1.2l.4 2.5h5l.4-2.5c.7-.3 1.4-.7 2-1.2l2.4.9 2-3.4-2-1.6c.1-.4.1-.8.1-1.2Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <span>Settings</span>
      </a>
    )}
  </nav>

  {/* The group's plan, above Our list: on a phone the top of its tab, on a
      wide screen between the tabs and the list. Always there, even empty,
      so a live refresh can bring one in. */}
  <section id="plans" class="plans" aria-label="Plan" data-panel="list">
    {error && PLAN_ERROR[error] && <p class="notice" role="alert">{PLAN_ERROR[error]}</p>}
    {view ? (
      <PlanCard view={view} group={group} member={member} isOwner={isOwner} needs={needs} />
    ) : (
      picks.length > 0 &&
      (isOwner ? (
        <div class="plan plan--empty">
          <span class="plan__icon" aria-hidden="true"><svg viewBox="0 0 20 20" width="20" height="20" set:html={calendar} /></span>
          <p><strong>Plan a day out</strong> Pick a place and a day; everyone marks when they're busy, and you set the time.</p>
          <a class="btn btn--small" href={`/g/${group.link}?plan=new#plan-start`} data-open-start>Plan a day</a>
        </div>
      ) : (
        // (a member can't start one, but sees where it will be: the
        // owner's to start, and theirs to answer)
        <div class="plan plan--empty plan--waiting">
          <span class="plan__icon" aria-hidden="true"><svg viewBox="0 0 20 20" width="20" height="20" set:html={calendar} /></span>
          <p><strong>No plan yet</strong> Ask the group owner to create one.</p>
        </div>
      ))
    )}
  </section>

  {/* Our list as a ranking: most keen first, the leader standing out, the
      rest compact rows, each with its keen count on its button. */}
  <section id="list" class="board__list" aria-labelledby="list-title" data-panel="list" data-editing={editing ? "" : undefined}>
    <div class="list-card">
      <div class="list-head">
        <h2 id="list-title">Our list</h2>
        {picks.length > 0 && (
          <a class="list-edit" href={editing ? `/g/${group.link}#list` : `/g/${group.link}?edit#list`} data-edit-toggle>
            <span class="list-edit__edit">Edit</span><span class="list-edit__done">Done</span>
          </a>
        )}
      </div>
      {removed && (
        <form class="notice notice--ok list-note" method="post" action={`/api/groups/${group.id}/picks`} role="status">
          <input type="hidden" name="place" value={removed.id} />
          <span>Took {removed.name} off the list.</span>
          <button class="list-note__undo">Undo</button>
        </form>
      )}
      {error === "remove" && (
        <p class="notice list-note" role="alert">That one stays: someone else is keen on it now. Only the owner can take it off.</p>
      )}
      {error === "remove-planned" && (
        <p class="notice list-note" role="alert">That one's in the plan: while the plan's on, only the owner can take it off.</p>
      )}
      {(error === "talk-gone" || (talkId > 0 && !talkOpen)) && (
        <p class="notice list-note" role="alert">That place isn't on the list now, so its Talk is put away. Add it back and it's there again.</p>
      )}
      {picks.length === 0 ? (
        <p class="empty">Nothing on the list yet. Add something from Explore.</p>
      ) : (
        <ol class="picks">
          {picks.map((pick, i) => {
            const { id, place, keen } = pick;
            const mine = keen.includes(member.name);
            // (others' keens go with it: the owner is asked first)
            const othersKeen = keen.filter((name) => name !== member.name).length;
            const lead = i === 0 && keen.length > 0;
            // (a stop of the plan on now stays put, but for the owner)
            const planned = plan?.stops.some((s) => s.id === place.id) ?? false;
            return (
              <li
                id={`pick-${id}`}
                class={`pick spot--${place.kind}${lead ? " pick--top" : ""}`}
                data-place={place.lat !== null ? place.id : undefined}
                data-place-id={place.id}
                data-planned={planned ? "" : undefined}
              >
                <SpotPhoto photo={place.photo} name={place.name} kind={place.kind} small />
                <div class="pick__main">
                  {lead && <p class="pick__lead">Most keen</p>}
                  <h3>{place.name}</h3>
                  <p class="area">
                    {place.area}
                    {planLine(place.id) && (
                      <span class="pick__plan">
                        {place.area && <span aria-hidden="true"> · </span>}
                        <svg viewBox="0 0 20 20" width="12" height="12" aria-hidden="true" set:html={calendar} />
                        <span class="sr-only">In the plan, </span>
                        {planLine(place.id)}
                      </span>
                    )}
                    {/* Talk about it: a bubble with how many messages, blue
                        and bold when some are new to you. A link to its
                        thread, which the script opens in place. */}
                    {(() => {
                      const t = talk.get(place.id);
                      const label = `Talk about ${place.name}${t ? `: ${t.total} ${t.total === 1 ? "message" : "messages"}${t.unread ? `, ${t.unread} new` : ""}` : ""}`;
                      return (
                        <a
                          class:list={["pick__talk", { "is-new": t?.unread, "is-empty": !t }]}
                          href={`/g/${group.link}?talk=${place.id}#talk`}
                          data-talk-open={place.id}
                          data-talk-name={place.name}
                          aria-label={label}
                        >
                          <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" set:html={bubble} />
                          {t && <span>{t.unread ? `${t.unread} new` : t.total}</span>}
                        </a>
                      );
                    })()}
                  </p>
                </div>
                <form method="post" action={`/api/groups/${group.id}/keen`} data-keen>
                  <input type="hidden" name="pick" value={id} />
                  <input type="hidden" name="keen" value={mine ? "off" : "on"} />
                  {/* (one shape either way, "3 keen", filled with a tick when it's
                      yours; its name says what a tap does) */}
                  <button
                    class={`keen${mine ? " keen--on" : ""}`}
                    aria-label={mine ? `Not keen on ${place.name} any more, ${keen.length} keen` : `I'm keen on ${place.name}, ${keen.length} keen`}
                  >
                    {mine && <svg class="keen__tick" viewBox="0 0 20 20" width="11" height="11" aria-hidden="true"><path d="m4.5 10.5 3.6 3.4 7.4-8" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>}
                    <span class="keen__count">{keen.length}</span>
                    <span>keen</span>
                  </button>
                </form>
                {canRemovePick(group, { ...pick, planned }, member) ? (
                  <form
                    method="post"
                    action={`/api/groups/${group.id}/picks`}
                    class="pick__remove"
                    data-remove={place.name}
                    data-confirm={othersKeen > 0 ? `Take ${place.name} off the list? ${othersKeen === 1 ? "1 keen goes" : `${othersKeen} keens go`} with it.` : undefined}
                  >
                    <input type="hidden" name="remove" value={id} />
                    <button class="remove" title="Take it off the list">
                      <svg viewBox="0 0 20 20" width="12" height="12" aria-hidden="true"><path d="M5 10h10" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" /></svg>
                      <span class="sr-only">Remove {place.name}</span>
                    </button>
                  </form>
                ) : planned ? (
                  <span class="pick__remove pick__locked" role="img" aria-label="In the plan, only the owner can take it off" title="In the plan, only the owner can take it off">
                    <svg viewBox="0 0 20 20" width="13" height="13" aria-hidden="true"><rect x="4.5" y="9" width="11" height="8" rx="2" fill="currentColor" /><path d="M7 9V6.8a3 3 0 0 1 6 0V9" fill="none" stroke="currentColor" stroke-width="1.7" /></svg>
                  </span>
                ) : (
                  <p class="pick__remove pick__by">{pick.addedById === member.id ? "Others keen" : `${pick.addedBy}'s`}</p>
                )}
              </li>
            );
          })}
        </ol>
      )}
    </div>
  </section>

  {/* Plans behind the group, folded at the foot of Our list. */}
  <section id="past-plans" class="past-plans" aria-label="Past plans" data-panel="list">
    {past.length > 0 && (
      <details class="past card" data-keep-open="past">
        <summary><h2>Past plans</h2><span>{past.length}</span></summary>
        <ol>
          {past.map((p) => {
            const { weekday, date } = dayParts(p.day);
            const off = p.calledOffAt !== null;
            return (
              <li class:list={{ "is-off": off || !p.set }}>
                <span class="cal cal--small" aria-hidden="true"><b>{weekday}</b><span>{date}</span></span>
                <span>
                  <strong>{stopNames(p.stops)}</strong>
                  {off ? <span class="past__tag">Called off</span> : !p.set && <span class="past__tag">No time set</span>}
                  <span class="past__when">{formatDay(p.day)}{p.set && !off && `, ${formatMinute(p.set.start)}`}</span>
                </span>
              </li>
            );
          })}
        </ol>
      </details>
    )}
  </section>

  </div>

  {/* Explore's title, search and cards, then the map. On a phone, in the
      Explore tab, the first two are one box that scrolls under the map
      (src/styles.css, "Explore on a phone"). */}
  <section id="explore-section" class="explore-wrap" aria-labelledby="explore-title" data-panel="explore">
    <div class="explore-scroll">
      <div class="explore-head">
        <div class="explore-head__top">
          <h2 id="explore-title">Explore</h2>
          <button type="button" class="show-all" data-show-all hidden>Show all</button>
        </div>
        {/* (its slot keeps its room while, on a phone's Explore, the search
            itself is pinned over the top of the scrolled cards) */}
        <div class="ask-slot">
          <form class="ask" method="get" action={`/g/${group.link}#explore`} role="search" data-search>
            <label for="ask-q" class="sr-only">Describe what you're after</label>
            <svg class="ask__glass" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M8.75 15a6.25 6.25 0 1 0 0-12.5 6.25 6.25 0 0 0 0 12.5Zm4.5-1.75 4.25 4.25" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
            </svg>
            <span class="ask__field">
              <input
                id="ask-q"
                name="q"
                type="search"
                enterkeyhint="search"
                value={q}
                maxlength="200"
                autocomplete="off"
                placeholder="Describe it: “cheap dumplings near Dickson”, “a walk with a view”"
              />
              <button type="button" class="ask__clear" aria-label="Clear the search" data-clear-search hidden={!q}>
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="m4 4 8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
              </button>
            </span>
            <button class="btn">Find</button>
          </form>
        </div>
        {/* (while a search is out, a quiet line says so, heard as well as seen) */}
        <p class="ask-status" aria-live="polite" data-ask-status></p>
        {/* (the kinds need the script that filters by them, so it shows them) */}
        <div class="filters" role="group" aria-label="Show only" data-sel={startKind} hidden>
          {kinds.map((k) => (
            <button type="button" class:list={["chip", `chip--${k}`, { "chip--on": k === startKind }]} data-filter={k} aria-pressed={k === startKind ? "true" : "false"}>
              <span class="chip__dot"><KindIcon kind={k} /></span>
              <span>{KIND_LABEL[k]}</span>
            </button>
          ))}
        </div>
        <p class="filter-empty" hidden>
          Nothing under <span data-empty-kind></span> yet. <a href="#add" data-tab="add">Share one</a>
        </p>
      </div>
      <div id="explore" data-q={q || undefined} data-near={nearOn ? "" : undefined}>
        <script type="application/json" id="pins" is:inline set:html={pinsJson} />
        {planStops.length > 0 && <NearPlan link={group.link} on={nearOn} stops={planStops} q={q} />}
        {found && (
          <p class="ask-meta">
            {found.places.length > 0 ? "Best matches first" : "Nothing shared fits that yet"}
            {found.near && ` · near ${found.near}`}
            {" · "}
            <a href={`/g/${group.link}#explore`} data-clear-search>Show every place</a>
          </p>
        )}
        <ul class="spots spots--explore">
          {paged.map((p) => (
            <li class={`spot spot--${p.kind}`} data-kind={p.kind} data-place={p.lat !== null ? p.id : undefined}>
              <SpotPhoto photo={p.photo} name={p.name} kind={p.kind} />
              <div class="spot__meta">
                <span class="tag"><KindIcon kind={p.kind} />{KIND_LABEL[p.kind]}</span>
                {p.groups > 0 && (
                  <span class="groups">
                    On {p.groups} {p.groups === 1 ? "list" : "lists"}
                  </span>
                )}
              </div>
              <h3>{p.name}</h3>
              <p class="area">{p.area}</p>
              {nearLine(p.id) && (
                <p class="spot__near">
                  <svg viewBox="0 0 256 256" width="12" height="12" aria-hidden="true"><path fill="currentColor" d={PIN_ICON} /></svg>
                  {nearLine(p.id)}
                </p>
              )}
              <p class="why">{p.addedBy === "Spots" ? p.why : `“${p.why}” — ${p.addedBy}`}</p>
              {member && (
                <div class="spot__actions">
                  {onList.has(p.id) ? (
                    <span class="added">On our list</span>
                  ) : (
                    <form method="post" action={`/api/groups/${group.id}/picks`}>
                      <input type="hidden" name="place" value={p.id} />
                      <button class="btn btn--small">Add to our list</button>
                    </form>
                  )}
                </div>
              )}
            </li>
          ))}
        </ul>
        {left > 0 && (
          <a class="explore-more" href={moreHref} data-more-link>
            Show {Math.min(left, PAGE)} more
          </a>
        )}
      </div>
    </div>
    <div class="map-wrap">
      <figure class="map-frame">
        <div id="map" role="region" aria-label="Map of the places in Explore"></div>
        <figcaption class="fold-credit">
          <span class="fold-credit__sources">
            © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>{" · "}<a href="https://openfreemap.org">OpenFreeMap</a>{" · relief "}<a href="https://github.com/tilezen/joerd/blob/master/docs/attribution.md">Mapzen</a>
          </span>
          <button type="button" class="fold-credit__info" aria-label="Map credits" aria-expanded="false">i</button>
        </figcaption>
      </figure>
    </div>
  </section>

  <div class="group-tools">
  {member && (
