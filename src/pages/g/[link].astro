      >
        <input type="hidden" name="action" value="reset" />
        <button class="row row--action">
          <span class="row__lead" aria-hidden="true">
            <svg viewBox="0 0 20 20" width="18" height="18"><path d="M15.5 8.5A5.8 5.8 0 0 0 5 6.2M4.5 11.5A5.8 5.8 0 0 0 15 13.8M5 2.8v3.6h3.6M15 17.2v-3.6h-3.6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
