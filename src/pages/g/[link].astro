  {isOwner && (
    <section id="settings" class="settings" aria-labelledby="settings-title" data-panel="settings">
      {/* The owner's tools, as My groups' lists (src/styles.css, "Lists"):
          the group's name typed into its row; anyone who may be one person
          twice; the people, each with Remove; and a new invite link. */}
      <h2 id="settings-title">Group settings</h2>
      <p class="fine">Only you see this: you started {group.name}.</p>
      {done && DONE[done] && <p class="notice notice--ok" role="status">{DONE[done]}</p>}

      <h3 class="lists__head">Group</h3>
      <form method="post" action={`/api/groups/${group.id}/owner`} class="card list">
        <input type="hidden" name="action" value="rename" />
        <label class="row row--field">
          <span class="row__label">Name</span>
          <input class="row__input" name="name" required maxlength="60" value={group.name} data-hint="Give the group a name." />
          <button class="btn btn--small row__save">Save</button>
