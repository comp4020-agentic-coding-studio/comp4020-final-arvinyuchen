    const askSlot = document.querySelector(".ask-slot");
    const exploreBox = document.querySelector(".explore-scroll");
    const PIN_BELOW = 2;
    function pinAsk() {
      if (!askSlot || !exploreBox) return;
      const box = exploreBox.getBoundingClientRect();
      const slot = askSlot.getBoundingClientRect();
      const boxed = getComputedStyle(exploreBox).overflowY === "auto" && box.height > 0;
