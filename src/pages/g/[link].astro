    // The owner's choice of start says itself on the button ("Set it: Sat 24
    // Oct, 2:15pm") and rings its window on the strip: a window's earliest
    // start (its chip), or the start typed in its field, which picks that
    // window and lets go of the chip (the field's script puts it back when
    // the chip is tapped: src/scripts/plan-start.ts).
    function minuteOf(value) {
      if (/^\d+$/.test(value)) return Number(value);
      const [h, m] = String(value).split(":").map(Number);
      return h * 60 + m;
    }
    function clockOf(minute) {
      return `${String(Math.floor(minute / 60) % 24).padStart(2, "0")}:${String(minute % 60).padStart(2, "0")}`;
    }
    function timeOf(minute) {
      const h = Math.floor(minute / 60) % 24;
