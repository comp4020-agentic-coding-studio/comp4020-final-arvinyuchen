---
import CityPhoto from "../../components/CityPhoto.astro";
import MiniMap from "../../components/MiniMap.astro";
import NoPasskey from "../../components/NoPasskey.astro";
import SpotPhoto from "../../components/SpotPhoto.astro";
import Base from "../../layouts/Base.astro";
import { KIND_LABEL, type Kind } from "../../lib/catalogue";
import { groupByLink, listMembers, listPicks, listPlaces, NOTE_MAX } from "../../lib/db";
import { clean, me, signedIn } from "../../lib/me";
import { search } from "../../lib/search";

// The link is the invite. After the owner resets it, the old one still
// brings members back (to the new link), but lets nobody new in.
const byLink = groupByLink(Astro.params.link ?? "");
if (!byLink) return Astro.redirect("/", 303);
if (byLink === "closed") return Astro.rewrite("/group-closed");
const { group } = byLink;
const member = me(Astro.cookies, group.id);
if (!byLink.current) return member ? Astro.redirect(`/g/${group.link}`, 303) : Astro.rewrite("/link-reset");

const account = signedIn(Astro.cookies);
const isOwner = member !== undefined && member.id === group.ownerId;
const members = listMembers(group.id);
const picks = listPicks(group.id);
const places = listPlaces();
const onList = new Set(picks.map((p) => p.place.id));
const kinds = Object.keys(KIND_LABEL) as Kind[];
const shareUrl = new URL(`/g/${group.link}`, Astro.url).href;
const isNew = Astro.url.searchParams.has("new");
// The invite goes person to person, never to a public feed: whoever holds the
// link can join, so there's no Facebook post or X button (see CLAUDE.md). On a
// phone the Share button opens the system sheet (Messages, WhatsApp, Messenger,
// Instagram, WeChat...); these links work everywhere, script or not.
const invite = `Join ${group.name} on Spots: we're picking places to go together.`;
const enc = encodeURIComponent;
// Each with a plain glyph of our own (a bubble, a plane, an envelope), not
// the apps' logos.
const sendBy = [
  {
    key: "sms",
    label: "Messages",
    href: `sms:?&body=${enc(`${invite} ${shareUrl}`)}`,
    glyph: "M4 5.5h16a1.5 1.5 0 0 1 1.5 1.5v8.5a1.5 1.5 0 0 1-1.5 1.5H10l-4.5 3.5V17H4a1.5 1.5 0 0 1-1.5-1.5V7A1.5 1.5 0 0 1 4 5.5Z",
  },
  {
    key: "whatsapp",
    label: "WhatsApp",
    href: `https://wa.me/?text=${enc(`${invite} ${shareUrl}`)}`,
    glyph: "M12 3.5a8.5 8.5 0 0 0-7.3 12.8L3.5 20.5l4.3-1.1A8.5 8.5 0 1 0 12 3.5ZM9 8.2c.3 2.9 3.6 6.3 6.8 6.8l.9-1.4-1.9-1-1 .9c-1-.4-2-1.4-2.5-2.5l.9-1-1-1.9Z",
  },
  {
    key: "telegram",
    label: "Telegram",
    href: `https://t.me/share/url?url=${enc(shareUrl)}&text=${enc(invite)}`,
    glyph: "M20.5 4.5 3.5 11.2l5.2 1.9 1.9 5.9 3-3.5 4.6 3.4 2.3-14.4ZM8.7 13.1l8.8-5.6-6.9 7.3",
  },
  {
    key: "email",
    label: "Email",
    href: `mailto:?subject=${enc(`Join ${group.name} on Spots`)}&body=${enc(`${invite}\n\n${shareUrl}`)}`,
    glyph: "M3.5 6.5h17v11h-17Zm0 0 8.5 6.5 8.5-6.5",
  },
];
const error = Astro.url.searchParams.get("error");
const done = Astro.url.searchParams.get("done");
const DONE: Record<string, string> = {
  renamed: "Renamed.",
  noted: "Note saved. It's what people see above the join form.",
  removed: "Removed from the group.",
  merged: "Merged: their keens and places are now one person's.",
  reset: "New invite link made. The old one no longer lets anyone join; send this one instead.",
};

// A search answers with cards only: Explore shows the matching places, best
// first, and the map shows just their pins.
const q = clean(Astro.url.searchParams.get("q"), 200);
const found = q ? await search(q, places) : null;
const shown = found ? found.places : places;

// What the map draws: every place in Explore that has a location. Carried as
// JSON inside #explore, so a live refresh of Explore refreshes the pins too.
const pins = shown
  .filter((p) => p.lat !== null && p.lon !== null)
  .map(({ id, name, kind, area, lat, lon }) => ({ id, name, kind, area, lat, lon }));
const pinsJson = JSON.stringify(pins).replace(/</g, "\\u003c");

// Before joining, the link shows a preview and nothing more: who's in, who
// started it, and the first few places, oldest first so the order says
// nothing about votes. The list, the keens and Explore are for members.
const owner = members.find((m) => m.id === group.ownerId);
const preview = [...picks].sort((a, b) => a.id - b.id).slice(0, 3);
// The note's words, each its own span so they can arrive one after another.
const noteWords = group.note?.split(" ") ?? [];

// The whole group keen (three or more of them) reads as "Everyone".
const everyone = (keen: string[]) => members.length > 2 && keen.length === members.length;

// Each member's initial in a colour of its own, the same on every visit.
const hue = (name: string) => [...name].reduce((h, c) => (h * 31 + c.codePointAt(0)!) % 360, 17);
---

<Base
  title={`${group.name} · Spots`}
  share={{
    title: `Join ${group.name} on Spots`,
    description: "A shared list of places to go, picked together. Join with your name and a passkey: no app, no password.",
    url: shareUrl,
  }}
>
  {!member ? (
  <section class="welcome" aria-labelledby="welcome-title">
    <div class="card welcome__card">
      <div class="welcome__hero">
        <CityPhoto class="welcome__photo" sizes="(min-width: 34rem) 32rem, 100vw" first />
        <header class="welcome__head">
          <p class="eyebrow">You're invited to</p>
          <h1 id="welcome-title">{group.name}</h1>
          <p class="members">
            <span class="faces" aria-hidden="true">
              {members.slice(0, 6).map((m) => (
                <span class="face" style={`--hue: ${hue(m.name)}`}>{[...m.name][0]?.toUpperCase()}</span>
              ))}
            </span>
            <span>
              {owner && <>{owner.name} started it · </>}
              {members.length} {members.length === 1 ? "person" : "people"}: {members.map((m) => m.name).join(", ")}
            </span>
          </p>
        </header>
      </div>

      {/* The card's modules, top to bottom: the photo and who's in it (above),
          the owner's message, then the one thing to do, on its own tinted
          footer. */}
      {group.note && (
        <div class="welcome__module">
          <figure class="welcome__note">
            <figcaption>
              {owner && (
                <span class="face" style={`--hue: ${hue(owner.name)}`} aria-hidden="true">
                  {[...owner.name][0]?.toUpperCase()}
                </span>
              )}
              <span class="welcome__from">
                {owner ? <><strong>{owner.name}</strong> sent you a message</> : "A message for you"}
              </span>
            </figcaption>
            <blockquote>{noteWords.map((w, i) => <>{i > 0 && " "}<span style={`--w: ${i}`}>{w}</span></>)}</blockquote>
          </figure>
        </div>
      )}
      <div class="welcome__module welcome__module--actions">
        {/* Everyone joins as an account. Signed in, it's one button; signed
            out, sending the form makes the account first (your name and a
            passkey, src/scripts/passkeys.ts), or "Sign in" finds the one
            you have and then sends it. */}
        <form
          id="join"
          method="post"
          action={`/api/groups/${group.id}/join`}
          class="stack welcome__form"
          data-account={account ? undefined : "new"}
          data-passkey-only={account ? undefined : ""}
        >
          <input type="hidden" name="link" value={group.link} />
          {error === "account" && (
            <p class="notice" role="alert">Joining needs an account: your name and a passkey.</p>
          )}
          {account ? (
            <>
              <p class="welcome__label">Join the group</p>
              <p class="welcome__field welcome__as">
                <span class="face welcome__you" aria-hidden="true" style={`--hue: ${hue(account.name)}`}>
                  {[...account.name][0]?.toUpperCase()}
                </span>
                <span>as <strong>{account.name}</strong></span>
              </p>
            </>
          ) : (
            <>
              <label for="join-name" class="welcome__label">Join the group<span class="sr-only">: your first name</span></label>
              <div class="welcome__field">
                {/* The face you'll have in the group, filled in as you type (src/scripts/welcome.ts). */}
                <span class="face welcome__you" aria-hidden="true"></span>
                <input id="join-name" name="name" required maxlength="40" autocomplete="nickname" placeholder="Your first name" />
              </div>
            </>
          )}
          <button class="btn btn--primary welcome__join">
            <span>Join {group.name}</span>
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
              <path d="M4 10h11M11 5.5 15.5 10 11 14.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <span class="passkey-msg" aria-live="polite"></span>
          {!account && (
            <p class="fine passkey-alt">
              You'll save a passkey for Spots: your face, fingerprint or phone PIN. Have one?{" "}
              <button type="button" class="linkish" data-passkey="signin" data-then="#join">Sign in</button>
            </p>
          )}
        </form>
        {!account && <NoPasskey to="join" />}
      </div>
    </div>

    <section class="card welcome__card welcome__listcard" id="on-the-list" aria-labelledby="on-the-list-title">
      <div class="welcome__content">
        <div class="welcome__list">
          <h2 id="on-the-list-title" class="welcome__label">On the list so far</h2>
          {preview.length > 0 ? (
            <>
              <MiniMap
                pins={preview.map(({ place }, i) => ({
                  n: i + 1,
                  name: place.name,
                  area: place.area,
                  kind: place.kind,
                  lat: place.lat,
                  lon: place.lon,
                }))}
              />
              <ol class="welcome__stops">
                {preview.map(({ place }, i) => (
                  <li class={`welcome__stop spot--${place.kind}`}>
                    <span class="welcome__num" aria-hidden="true">{i + 1}</span>
                    <strong>{place.name}</strong>
                    <span class="welcome__where">{place.area ?? KIND_LABEL[place.kind]}</span>
                  </li>
                ))}
              </ol>
            </>
          ) : (
            <p class="fine">Nothing yet: you could add the first place.</p>
          )}
        </div>
      </div>
    </section>
  </section>
  ) : (
  <>
  <div class="group-page">
  {/* The group's own column: who and inviting, the tabs, and Our list. On a
      wide screen it stands on the left beside Explore and the map. */}
  <div class="group-side">
  <section class="group-head group-head--split">
    <div class="group-head__title">
      <h1>{group.name}</h1>
      {group.note && (
        <p class="group-note">
          “{group.note}” <span class="fine">{owner ? `${owner.name}, to the group` : ""}</span>
        </p>
      )}
      <p class="members">
        <span class="faces" aria-hidden="true">
          {members.slice(0, 6).map((m) => (
            <span class="face" style={`--hue: ${hue(m.name)}`}>{[...m.name][0]?.toUpperCase()}</span>
          ))}
        </span>
        <span>
          {members.length} {members.length === 1 ? "person" : "people"}: {members.map((m) => m.name).join(", ")}
        </span>
      </p>
      <p class="you">
        You're in as <strong>{member.name}</strong>
        {isOwner && <span class="owner-tag">owner</span>}
      </p>
    </div>
    {/* The invite, folded behind a button: it's needed once, then every
        visit would open on it. Open by itself while the group is new or
        still just its owner. A <details>, so it opens without a script. */}
    <details class="invite" id="invite" open={isNew || members.length === 1}>
      <summary class="btn invite__open">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <path d="M8 9.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM2.5 16.5c.6-2.8 2.8-4.5 5.5-4.5s4.9 1.7 5.5 4.5M15.5 6.5v5M13 9h5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
        Invite friends
      </summary>
      {/* The invite as one panel: what it's for, the link with Copy in it,
          Share… where there's a share sheet, and the private channels as
          tiles. Never a public feed (CLAUDE.md). */}
      <div class={`share card${isNew ? " share--new" : ""}`}>
        <h2 class="share__title">{isNew ? "Your group is ready" : `Invite friends to ${group.name}`}</h2>
        <p class="fine share__say">
          {isNew ? "Send this link to everyone coming. " : ""}Anyone with it can join, so send it to people, not a feed.
        </p>
        <div class="share__row">
          <div class="share__link">
            <label for="share-link" class="sr-only">Invite link</label>
            <input id="share-link" value={shareUrl} readonly />
            <button type="button" class="share__copy" data-copy="#share-link">Copy</button>
          </div>
          <button type="button" class="btn btn--primary share__native" data-share data-title={`Join ${group.name} on Spots`} data-text={invite}>
            Share…
          </button>
          <ul class="share__by" aria-label="Or send it by">
            {sendBy.map(({ key, label, href, glyph }) => (
              <li>
                <a class={`share__app share__app--${key}`} href={href} {...(href.startsWith("https:") ? { target: "_blank", rel: "noopener" } : {})}>
                  <span class="share__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22"><path d={glyph} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round" /></svg>
                  </span>
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </details>
  </section>

  {/* One part of the group at a time: tabs, by the script below. Without
      it they're links down the page, and every part is there. */}
  {/* (with a glyph each, for when they're the phone's tab bar) */}
  <nav class="section-nav tabs" aria-label="Group">
    <a href="#list" data-tab="list">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <span>Our list</span> <span class="tabs__n">{picks.length}</span>
    </a>
    <a href="#explore-section" data-tab="explore">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M9 4 3.5 6v14L9 18l6 2 5.5-2V4L15 6 9 4Zm0 0v14m6-12v14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <span>Explore</span>
    </a>
    <a href="#add" data-tab="add">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Zm0-13.5v5m-2.5-2.5h5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <span>Share</span>
    </a>
    {isOwner && (
      <a href="#settings" data-tab="settings">
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm7.4-3a7.4 7.4 0 0 0-.1-1.2l2-1.6-2-3.4-2.4.9a7.5 7.5 0 0 0-2-1.2L14.5 3h-5l-.4 2.5a7.5 7.5 0 0 0-2 1.2l-2.4-.9-2 3.4 2 1.6a7.4 7.4 0 0 0 0 2.4l-2 1.6 2 3.4 2.4-.9c.6.5 1.3.9 2 1.2l.4 2.5h5l.4-2.5c.7-.3 1.4-.7 2-1.2l2.4.9 2-3.4-2-1.6c.1-.4.1-.8.1-1.2Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <span>Settings</span>
      </a>
    )}
  </nav>

  {/* Our list as a ranking: most keen first, the leader standing out, the
      rest compact rows, each with who's keen. */}
  <section id="list" class="board__list" aria-labelledby="list-title" data-panel="list">
    <h2 id="list-title">Our list</h2>
    {picks.length === 0 ? (
      <p class="empty">Nothing on the list yet. Add something from Explore.</p>
    ) : (
      <ol class="picks">
        {picks.map(({ id, place, keen }, i) => {
          const mine = keen.includes(member.name);
          const lead = i === 0 && keen.length > 0;
          return (
            <li
              id={`pick-${id}`}
              class={`pick spot--${place.kind}${lead ? " pick--top" : ""}`}
              data-place={place.lat !== null ? place.id : undefined}
            >
              <SpotPhoto photo={place.photo} name={place.name} kind={place.kind} small />
              <div class="pick__main">
                {lead && <p class="pick__lead">Most keen</p>}
                <h3>{place.name}</h3>
                <p class="area">{[place.area, KIND_LABEL[place.kind]].filter(Boolean).join(" · ")}</p>
                <p class="keen-who">
                  {keen.length > 0 ? (
                    <>
                      <span class="faces faces--small" aria-hidden="true">
                        {keen.slice(0, 5).map((name) => (
                          <span class="face" style={`--hue: ${hue(name)}`}>{[...name][0]?.toUpperCase()}</span>
                        ))}
                      </span>
                      <span class="sr-only">Keen: </span>
                      <span class="keen-who__names">{everyone(keen) ? "Everyone" : keen.join(", ")}</span>
                    </>
                  ) : (
                    "No one's keen yet"
                  )}
                </p>
              </div>
              <form method="post" action={`/api/groups/${group.id}/keen`} data-keen>
                <input type="hidden" name="pick" value={id} />
                <input type="hidden" name="keen" value={mine ? "off" : "on"} />
                <button class={`keen${mine ? " keen--on" : ""}`} aria-pressed={mine ? "true" : "false"}>
                  <span class="keen__count">{keen.length}</span>
                  <span>{mine ? "Keen!" : "I'm keen"}</span>
                </button>
              </form>
            </li>
          );
        })}
      </ol>
    )}
  </section>

  </div>

  <section id="explore-section" class="explore-wrap" aria-labelledby="explore-title" data-panel="explore">
    <div class="explore-head">
      <h2 id="explore-title">Explore</h2>
      <div class="filters" role="group" aria-label="Show" hidden>
        <button type="button" class="chip chip--on" data-filter="all" aria-pressed="true">All</button>
        {kinds.map((k) => (
          <button type="button" class={`chip chip--${k}`} data-filter={k} aria-pressed="false">
            {KIND_LABEL[k]}
          </button>
        ))}
      </div>
      <form class="ask" method="get" action={`/g/${group.link}#explore`} role="search" data-search>
        <label for="ask-q" class="sr-only">Describe what you're after</label>
        <input
          id="ask-q"
          name="q"
          value={q}
          maxlength="200"
          autocomplete="off"
          placeholder="Describe it: “cheap dumplings near Dickson”, “a walk with a view”"
        />
        <button class="btn btn--primary">Find</button>
      </form>
    </div>
    <div class="explore-grid">
      <div id="explore" data-q={q || undefined}>
        <script type="application/json" id="pins" is:inline set:html={pinsJson} />
        {found && (
          <p class="ask-meta">
            {found.places.length > 0 ? "Best matches first" : "Nothing shared fits that yet"}
            {found.near && ` · near ${found.near}`}
            {" · "}
            <a href={`/g/${group.link}#explore`} data-clear-search>Show every place</a>
          </p>
        )}
        <ul class="spots spots--explore">
          {shown.map((p) => (
            <li class={`spot spot--${p.kind}`} data-kind={p.kind} data-place={p.lat !== null ? p.id : undefined}>
              <SpotPhoto photo={p.photo} name={p.name} kind={p.kind} />
              <div class="spot__meta">
                <span class="tag">{KIND_LABEL[p.kind]}</span>
                {p.groups > 0 && (
                  <span class="groups">
                    On {p.groups} {p.groups === 1 ? "list" : "lists"}
                  </span>
                )}
              </div>
              <h3>{p.name}</h3>
              <p class="area">{p.area}</p>
              <p class="why">{p.addedBy === "Spots" ? p.why : `“${p.why}” — ${p.addedBy}`}</p>
              <div class="spot__actions">
                {p.lat !== null && (
                  <button type="button" class="btn btn--small btn--ghost" data-fly={p.id}>
                    Show on map
                  </button>
                )}
                {member &&
                  (onList.has(p.id) ? (
                    <span class="added">On our list</span>
                  ) : (
                    <form method="post" action={`/api/groups/${group.id}/picks`}>
                      <input type="hidden" name="place" value={p.id} />
                      <button class="btn btn--small">Add to our list</button>
                    </form>
                  ))}
              </div>
            </li>
          ))}
        </ul>
      </div>
      <div class="map-wrap">
        <figure class="map-frame">
          <div id="map" role="region" aria-label="Map of the places in Explore"></div>
          <figcaption class="fold-credit">
            <span class="fold-credit__sources">
              © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>{" · "}<a href="https://openfreemap.org">OpenFreeMap</a>{" · relief "}<a href="https://github.com/tilezen/joerd/blob/master/docs/attribution.md">Mapzen</a>
            </span>
            <button type="button" class="fold-credit__info" aria-label="Map credits" aria-expanded="false">i</button>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <div class="group-tools">
  {member && (
    <section id="add" class="card add" aria-labelledby="add-title" data-panel="add">
      <h2 id="add-title">Share a good place</h2>
      <p class="fine">
        It goes into Explore for every group, so only add somewhere you'd actually send a friend, and say why.
      </p>
      {error === "place" && <p class="notice" role="alert">A place needs a name, a kind and a reason it's good.</p>}
      <div class="finder" hidden>
        <label for="find-q"><span>Find it on the map</span></label>
        <div class="finder__row">
          <input id="find-q" placeholder="e.g. Morning Glory Dickson" autocomplete="off" />
          <button type="button" class="btn" id="find-go">Find</button>
        </div>
        <ul class="finder__results" aria-live="polite"></ul>
      </div>
      <form method="post" action={`/api/groups/${group.id}/places`} class="grid-form" id="add-form">
        <input type="hidden" name="osm" />
        <input type="hidden" name="lat" />
        <input type="hidden" name="lon" />
        <label>
          <span>Name</span>
          <input name="name" required maxlength="80" placeholder="That dumpling place" />
        </label>
        <label>
          <span>Kind</span>
          <select name="kind" required>
            {kinds.map((k) => <option value={k}>{KIND_LABEL[k]}</option>)}
          </select>
        </label>
        <label>
          <span>Suburb</span>
          <input name="area" maxlength="40" placeholder="Dickson" />
        </label>
        <label class="wide">
          <span>Why it's good (required)</span>
          <input name="why" required maxlength="160" placeholder="Best chilli oil in Canberra, and open late" />
        </label>
        <p class="located wide" hidden></p>
        <button class="btn btn--primary wide">Share it and add to our list</button>
      </form>
    </section>
  )}

  {isOwner && (
    <section id="settings" class="card settings" aria-labelledby="settings-title" data-panel="settings">
      <h2 id="settings-title">Group settings</h2>
      <p class="fine">Only you see this: you started {group.name}.</p>
      {done && DONE[done] && <p class="notice notice--ok" role="status">{DONE[done]}</p>}

      <form method="post" action={`/api/groups/${group.id}/owner`} class="settings__row">
        <input type="hidden" name="action" value="rename" />
        <label class="grow">
          <span>Group name</span>
          <input name="name" required maxlength="60" value={group.name} />
        </label>
        <button class="btn">Rename</button>
      </form>

      <form method="post" action={`/api/groups/${group.id}/owner`} class="settings__row">
        <input type="hidden" name="action" value="note" />
        <label class="grow">
          <span>A note for people you invite</span>
          <input
            name="note"
            maxlength={NOTE_MAX}
            value={group.note ?? ""}
            placeholder="Where are we going Friday? Add yours by Wednesday."
          />
        </label>
        <button class="btn">Save</button>
      </form>
      <p class="fine">It's the first thing someone sees when they open your invite link. Leave it empty to take it down.</p>

      <h3>People</h3>
      <ul class="people">
        {members.map((m) => (
          <li>
            <span class="people__name">
              {m.name}
              {m.id === group.ownerId && <span class="owner-tag">owner</span>}
            </span>
            {m.id !== group.ownerId && (
              <form method="post" action={`/api/groups/${group.id}/owner`} data-confirm={`Remove ${m.name}? Their keens go too.`}>
                <input type="hidden" name="action" value="remove" />
                <input type="hidden" name="member" value={m.id} />
                <button class="btn btn--small btn--ghost">Remove</button>
              </form>
            )}
          </li>
        ))}
      </ul>

      {members.length > 1 && (
        <form method="post" action={`/api/groups/${group.id}/owner`} class="settings__row merge">
          <input type="hidden" name="action" value="merge" />
          <label>
            <span>Same person twice? Merge</span>
            <select name="member" required>
              {members.map((m) => <option value={m.id}>{m.name} (#{m.id})</option>)}
            </select>
          </label>
          <label>
            <span>into</span>
            <select name="into" required>
              {members.map((m, i) => <option value={m.id} selected={i === 0}>{m.name} (#{m.id})</option>)}
            </select>
          </label>
          <button class="btn">Merge</button>
        </form>
      )}
      {members.length > 1 && (
        <p class="fine">
          Someone who lost every passkey makes a new account and joins again by the link: merge their old name into
          the new one, and their keens and places come with them.
        </p>
      )}

      <h3>Invite link</h3>
      <form
        method="post"
        action={`/api/groups/${group.id}/owner`}
        class="settings__row"
        data-confirm="Make a new invite link? The old one will stop letting anyone new join."
      >
        <input type="hidden" name="action" value="reset" />
        <p class="fine grow">
          If the link got passed around further than you meant, make a new one. Everyone already in stays in.
        </p>
        <button class="btn">Reset invite link</button>
      </form>
    </section>
  )}
  </div>
  </div>

  <script is:inline define:vars={{ groupId: group.id }}>
    // Live: anyone joining, picking or voting in this group, or any group
    // sharing a new place, reaches every open page within a moment, with no
    // reload by the viewer. The page asks the server for itself again and
    // swaps in the changed parts, keeping the scroll position, the map and
    // anything typed in the forms.
    const regions = [".group-head h1", ".group-head .members", ".share__row", ".tabs__n", "#list", "#explore", "#settings .people"];
    // The page as it is now, search included, without one-off notices.
    const current = () => {
      const q = new URLSearchParams(location.search).get("q");
      return location.pathname + (q ? `?q=${encodeURIComponent(q)}` : "");
    };
    // The list is always in rank order: a live refresh re-ranks it, and
    // each card glides from where it was to its new place, so the group
    // sees what moved (PROCESS.md, "Several people voting at once"). For a
    // moment after a move, a keen tap is ignored: it was aimed at whatever
    // card was there before.
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    let movedAt = 0;
    function rerank(now, next) {
      const was = new Map([...now.querySelectorAll(".picks > li")].map((li) => [li.id, li.getBoundingClientRect().top]));
      const order = [...was.keys()].join();
      const focused = document.activeElement?.closest(".picks > li")?.id;
      now.innerHTML = next.innerHTML;
      // (no entrance replayed: only cards that are new arrive)
      now.dataset.live = "";
      const cards = [...now.querySelectorAll(".picks > li")];
      if (focused) now.querySelector(`#${CSS.escape(focused)} .keen`)?.focus({ preventScroll: true });
      if (cards.map((li) => li.id).join() === order) return;
      movedAt = performance.now();
      if (still.matches) return;
      for (const li of cards) {
        const from = was.get(li.id);
        if (from === undefined) {
          li.animate([{ opacity: 0, transform: "translateY(6px)" }, { opacity: 1, transform: "none" }], { duration: 300, easing: "ease-out" });
          continue;
        }
        const dy = from - li.getBoundingClientRect().top;
        if (dy) li.animate([{ transform: `translateY(${dy}px)` }, { transform: "none" }], { duration: 450, easing: "cubic-bezier(0.2, 0.8, 0.2, 1)" });
      }
    }
    let pending = false;
    let again = false;
    async function refresh() {
      // A change that lands mid-refresh gets its own pass afterwards, so the
      // last vote is never the one that's missed.
      if (pending) {
        again = true;
        return;
      }
      pending = true;
      try {
        const res = await fetch(current(), { cache: "no-store" });
        // A reset invite link sends members on to the new one: follow it.
        const landed = new URL(res.url);
        if (landed.pathname !== location.pathname) history.replaceState(null, "", landed.pathname + location.search + location.hash);
        const html = await res.text();
        const fresh = new DOMParser().parseFromString(html, "text/html");
        for (const selector of regions) {
          const now = document.querySelector(selector);
          const next = fresh.querySelector(selector);
          if (!now || !next) continue;
          if (selector === "#list") {
            if (now.innerHTML !== next.innerHTML) rerank(now, next);
          } else if (now.innerHTML !== next.innerHTML) now.innerHTML = next.innerHTML;
        }
        document.dispatchEvent(new Event("spots:refreshed"));
      } catch {
        location.reload();
      } finally {
        pending = false;
        if (again) {
          again = false;
          refresh();
        }
      }
    }
    // A keen posts in the background, so the page (and its order) stays put.
    // If that fails, the form posts the plain way.
    document.addEventListener("submit", async (event) => {
      const form = event.target.closest("[data-keen]");
      if (!form) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      // Busy rather than disabled: disabling would drop the keyboard focus.
      if (form.dataset.busy || performance.now() - movedAt < 450) return;
      form.dataset.busy = "true";
      try {
        const res = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { "x-spots": "in-page" } });
        if (!res.ok) throw new Error(String(res.status));
        await refresh();
      } catch {
        form.submit();
      } finally {
        delete form.dataset.busy;
      }
    }, true);
    const source = new EventSource(`/api/events?group=${encodeURIComponent(groupId)}`);
    source.addEventListener("change", refresh);
    source.addEventListener("places", refresh);
    let opened = false;
    source.addEventListener("open", () => {
      if (opened) refresh();
      opened = true;
    });
    // Owner actions that can't be undone ask first.
    document.addEventListener(
      "submit",
      (event) => {
        const ask = event.target.dataset.confirm;
        if (ask && !window.confirm(ask)) {
          event.preventDefault();
          event.stopImmediatePropagation();
        }
      },
      true,
    );
    // A form that posts leaves the page, so the stream closes with it. Search
    // stays on the page: it asks for Explore with the prompt and swaps the
    // answer in, and the map fits itself to the cards that came back.
    document.addEventListener(
      "submit",
      (event) => {
        if (!event.target.matches("[data-search], [data-keen]")) source.close();
      },
      true,
    );
    const ask = document.querySelector("[data-search]");
    const askInput = ask?.querySelector("input[name=q]");
    async function showSearch(q, push) {
      const url = location.pathname + (q ? `?q=${encodeURIComponent(q)}` : "") + "#explore";
      if (push) history.pushState(null, "", url);
      const button = ask.querySelector("button");
      const explore = document.querySelector("#explore");
      button.disabled = true;
      explore.classList.add("is-asking");
      try {
        const html = await (await fetch(current(), { cache: "no-store" })).text();
        const next = new DOMParser().parseFromString(html, "text/html").querySelector("#explore");
        if (next) {
          explore.innerHTML = next.innerHTML;
          if (next.dataset.q) explore.dataset.q = next.dataset.q;
          else delete explore.dataset.q;
        }
        document.dispatchEvent(new Event("spots:refreshed"));
        document.dispatchEvent(new Event("spots:searched"));
      } catch {
        location.href = url;
      } finally {
        button.disabled = false;
        explore.classList.remove("is-asking");
      }
    }
    ask?.addEventListener("submit", (event) => {
      event.preventDefault();
      showSearch(askInput.value.trim(), true);
    });
    document.addEventListener("click", (event) => {
      if (!event.target.closest("[data-clear-search]")) return;
      event.preventDefault();
      askInput.value = "";
      showSearch("", true);
    });
    window.addEventListener("popstate", () => {
      // (only when the search itself changed, not on going back a tab)
      const q = new URLSearchParams(location.search).get("q") ?? "";
      if (q === (document.querySelector("#explore")?.dataset.q ?? "")) return;
      askInput.value = q;
      showSearch(q, false);
    });

    // Tabs: one part of the group at a time (Our list, Explore, Share a
    // place, Settings), the open one in the URL's #, so a reload, the back
    // button or a form that lands on #settings opens the right one. On a
    // wide screen Our list is always there in the left column, so the tabs
    // choose what's beside it: Explore (with the map), Share or Settings.
    const page = document.querySelector(".group-page");
    const tabLinks = [...document.querySelectorAll(".tabs a[data-tab]")];
    const panels = [...document.querySelectorAll("[data-panel]")];
    const wide = matchMedia("(min-width: 1180px)");
    const tabOf = (hash) => {
      if (/^#(explore|explore-section)$/.test(hash)) return "explore";
      if (hash === "#add") return "add";
      if (hash === "#settings" && document.querySelector("#settings")) return "settings";
      return "list";
    };
    let tab = tabOf(location.hash);
    function show(next, scroll) {
      tab = next;
      page.dataset.tab = tab;
      const beside = wide.matches && tab === "list" ? "explore" : tab;
      for (const panel of panels) {
        const kind = panel.dataset.panel;
        panel.hidden = !(kind === beside || (wide.matches && kind === "list"));
      }
      for (const a of tabLinks) {
        if (a.dataset.tab === beside) a.setAttribute("aria-current", "page");
        else a.removeAttribute("aria-current");
      }
      // (a map shown again takes its size)
      window.dispatchEvent(new Event("resize"));
      // The tab opens at its top, under the tabs, never scrolled half way.
      const top = document.querySelector(".group-head").getBoundingClientRect().bottom + scrollY;
      if (scroll && scrollY > top) scrollTo({ top, behavior: "instant" });
    }
    page.classList.add("is-tabbed");
    show(tab, false);
    // (a link to one card, like a vote without the script, still lands on it)
    try {
      if (location.hash) document.querySelector(location.hash)?.scrollIntoView();
    } catch {
      // (a # that isn't an id)
    }
    wide.addEventListener("change", () => show(tab, false));
    window.addEventListener("popstate", () => show(tabOf(location.hash), true));
    function go(next, hash) {
      if (location.hash !== hash) history.pushState(null, "", location.pathname + location.search + hash);
      show(next, true);
    }
    document.addEventListener("click", (event) => {
      const link = event.target.closest(".tabs a[data-tab]");
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      go(link.dataset.tab, link.hash);
    });
    // A tap on a place in the list shows it on the map, which on a narrow
    // screen is Explore's: open that first (src/scripts/map.ts then flies).
    document.addEventListener(
      "click",
      (event) => {
        if (wide.matches || tab !== "list") return;
        if (event.target.closest("button, a, form, input, select, label")) return;
        if (event.target.closest("#list [data-place]")) go("explore", "#explore-section");
      },
      true,
    );

    // Where the invite opens over the page (beside the name, wider than a
    // phone), a click outside it or Escape closes it, as a popover would.
    const inviteBox = document.querySelector("#invite");
    const floating = () => inviteBox?.open && getComputedStyle(inviteBox.querySelector(".share")).position === "absolute";
    document.addEventListener("click", (event) => {
      if (floating() && !inviteBox.contains(event.target)) inviteBox.open = false;
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !floating()) return;
      inviteBox.open = false;
      inviteBox.querySelector("summary").focus();
    });

    // Delegated, since a reset invite link swaps the share row in live.
    document.addEventListener("click", async (event) => {
      const button = event.target.closest("[data-copy]");
      if (!button) return;
      const input = document.querySelector(button.dataset.copy);
      try {
        await navigator.clipboard.writeText(input.value);
        button.textContent = "Copied";
      } catch {
        input.select();
      }
      setTimeout(() => (button.textContent = "Copy"), 1500);
    });

    // The system share sheet, where there is one (phones, Safari, Edge): it
    // reaches every app on the device, Instagram and WeChat included, which
    // no web link can. Elsewhere the button stays hidden and the links do.
    if (navigator.share) document.documentElement.classList.add("can-share");
    document.addEventListener("click", async (event) => {
      const button = event.target.closest("[data-share]");
      if (!button) return;
      const url = document.querySelector("#share-link").value;
      try {
        await navigator.share({ title: button.dataset.title, text: button.dataset.text, url });
      } catch {
        // Closing the sheet without picking an app is not an error worth showing.
      }
    });
  </script>
  </>
  )}
  <script>
    import "../../scripts/map";
    import "../../scripts/passkeys";
    import "../../scripts/welcome";
  </script>
</Base>
