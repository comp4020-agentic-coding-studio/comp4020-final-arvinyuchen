  </div>
  </div>

  {/* (the live region stays on the page, so a screen reader hears each note
      the toast shows; the toast itself comes and goes inside it) */}
  <div role="status" aria-live="polite">
    <div id="toast" class="toast" hidden>
      <span class="toast__text"></span>
      <button type="button" class="toast__undo" hidden>Undo</button>
    </div>
  </div>

  {/* The plan's sheets: the owner's (start it, or change its day; an exact
      time), and everyone's busy times. Always there, even empty, so a live refresh can
      bring them in; it leaves them be while one is open. */}
  <div id="plan-sheets">
    {isOwner && (plan || picks.length > 0) && (
      <PlanStart group={group} picks={picks} plan={plan} open={planParam === "new" || planParam === "change"} error={error === "plan-start"} />
    )}
    {view && <BusySheet group={group} view={view} open={Astro.url.searchParams.has("busy")} error={error === "busy"} isOwner={isOwner} />}
    {view && isOwner && !view.plan.set && <PlanExact group={group} view={view} open={planParam === "exact"} />}
  </div>
  <TalkSheet group={group} open={talkOpen} error={talkOpen && error?.startsWith("talk-") ? error : null} />

  <script is:inline define:vars={{ groupId: group.id, isOwner }}>
    // Live: anyone joining, picking or voting in this group, or any group
    // sharing a new place, reaches every open page within a moment, with no
    // reload by the viewer. The page asks the server for itself again and
    // swaps in the changed parts, keeping the scroll position, the map and
    // anything typed in the forms.
    const regions = [".group-head h1", ".next-up-slot", ".joined-slot", ".group-head .who__count", ".group-head .who__grid", ".group-head .who__fold", ".share__row", ".tabs__n", ".tabs__flag", "#plans", "#list", "#past-plans", "#explore", "#settings .people", "#plan-sheets"];
    // The page as it is now, its search, "Near your plan", kind and how
    // many of Explore's cards included, without one-off notices; or with
    // one of those changed (a new search or kind starts from one page).
    function exploreUrl(change = {}) {
      const now = new URLSearchParams(location.search);
      const keep = new URLSearchParams();
      const q = "q" in change ? change.q : now.get("q");
      if (q) keep.set("q", q);
      if ("near" in change ? change.near : now.has("near")) keep.set("near", "");
      const kind = "kind" in change ? change.kind : now.get("kind");
      if (kind && kind !== "all") keep.set("kind", kind);
      const fresh = "q" in change || "kind" in change;
      const more = "more" in change ? change.more : fresh ? null : now.get("more");
      if (more) keep.set("more", more);
      const at = "at" in change ? change.at : fresh ? null : now.get("at");
      if (at) keep.set("at", at);
      const query = keep.toString().replace(/near=(&|$)/, "near$1");
      return location.pathname + (query ? `?${query}` : "");
    }
    const current = () => exploreUrl();
    // The list is always in rank order: a live refresh re-ranks it, and
    // each card glides from where it was to its new place, so the group
    // sees what moved (PROCESS.md, "Several people voting at once"). For a
    // moment after a move, a keen tap is ignored: it was aimed at whatever
    // card was there before.
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    let movedAt = 0;
    function rerank(now, next) {
      const was = new Map([...now.querySelectorAll(".picks > li")].map((li) => [li.id, li.getBoundingClientRect().top]));
      const order = [...was.keys()].join();
      const focused = document.activeElement?.closest(".picks > li")?.id;
      now.innerHTML = next.innerHTML;
      // (no entrance replayed: only cards that are new arrive)
      now.dataset.live = "";
      const cards = [...now.querySelectorAll(".picks > li")];
      if (focused) now.querySelector(`#${CSS.escape(focused)} .keen`)?.focus({ preventScroll: true });
      if (cards.map((li) => li.id).join() === order) return;
      movedAt = performance.now();
      if (still.matches) return;
      for (const li of cards) {
        const from = was.get(li.id);
        if (from === undefined) {
          li.animate([{ opacity: 0, transform: "translateY(6px)" }, { opacity: 1, transform: "none" }], { duration: 300, easing: "ease-out" });
          continue;
        }
        const dy = from - li.getBoundingClientRect().top;
        if (dy) li.animate([{ transform: `translateY(${dy}px)` }, { transform: "none" }], { duration: 450, easing: "cubic-bezier(0.2, 0.8, 0.2, 1)" });
      }
    }
    // A part redrawn keeps what the viewer had open in it (a fold, the
    // plan's menu) and the start the owner chose. The plan's card changing
    // height moves the list under it, so a keen tap waits, as after a move.
    let sheetsBehind = false;
    function swap(now, next) {
      const open = [...now.querySelectorAll("details[data-keep-open][open]")].map((d) => d.dataset.keepOpen);
      const pick = now.querySelector(".plan__pick[data-chosen]");
      const at = pick?.querySelector("input[name=at]:checked")?.value;
      const typed = at && pick.querySelector(`input[name="start-${at.split("-")[0]}"]:not(:disabled)`)?.value;
      const more = pick?.querySelector(".wins__more-toggle")?.checked;
      const tall = now.offsetHeight;
      now.innerHTML = next.innerHTML;
      for (const key of open) now.querySelector(`details[data-keep-open="${CSS.escape(key)}"]`)?.setAttribute("open", "");
      const fresh = now.querySelector(".plan__pick");
      if (pick && fresh) {
        const radio = at && [...fresh.querySelectorAll("input[name=at]")].find((r) => r.value === at);
        if (radio) {
          radio.checked = true;
          fresh.dataset.chosen = "";
          // (and the start typed in it, which the field takes up as it's drawn)
          const field = radio.closest(".starts").querySelector("input[data-start-field]");
          if (field && typed) {
            field.value = clockOf(minuteOf(typed));
            radio.closest(".starts").classList.toggle("is-typed", minuteOf(typed) !== Number(field.dataset.start ?? field.dataset.min));
          }
        }
        const toggle = fresh.querySelector(".wins__more-toggle");
        if (toggle && more) toggle.checked = true;
      }
      if (now.id === "plans" && now.offsetHeight !== tall) movedAt = performance.now();
    }
    let pending = false;
    let again = false;
    // (a card on its way out finishes leaving before the list is redrawn)
    let leaving = null;
    async function refresh() {
      // A change that lands mid-refresh gets its own pass afterwards, so the
      // last vote is never the one that's missed.
      if (pending) {
        again = true;
        return;
      }
      pending = true;
      try {
        await leaving;
        const res = await fetch(current(), { cache: "no-store" });
        // A reset invite link sends members on to the new one: follow it.
        const landed = new URL(res.url);
        if (landed.pathname !== location.pathname) history.replaceState(null, "", landed.pathname + location.search + location.hash);
        const html = await res.text();
        const fresh = new DOMParser().parseFromString(html, "text/html");
        for (const selector of regions) {
          const now = document.querySelector(selector);
          const next = fresh.querySelector(selector);
          if (!now || !next || now.innerHTML === next.innerHTML) continue;
          // (a sheet open over the page isn't redrawn under the finger: it
          // catches up when it closes)
          if (selector === "#plan-sheets" && now.querySelector("dialog[open]")) sheetsBehind = true;
          else if (selector === "#list") rerank(now, next);
          else swap(now, next);
        }
        planLabel();
        noticePlan();
        document.dispatchEvent(new Event("spots:refreshed"));
      } catch {
        location.reload();
      } finally {
        pending = false;
        if (again) {
          again = false;
          refresh();
        }
      }
    }
    // A note at the foot of the screen for a moment, with an action in it
    // (Undo, Fill in) or none.
    const toast = document.querySelector("#toast");
    let toastTimer;
    function say(text, action, label = "Undo") {
      clearTimeout(toastTimer);
      // (shown, then its words, so they're heard as they arrive)
      toast.hidden = false;
      toast.querySelector(".toast__text").textContent = text;
      const button = toast.querySelector(".toast__undo");
      button.textContent = label;
      button.hidden = !action;
      button.onclick = action ? () => { toast.hidden = true; action(); } : null;
      toastTimer = setTimeout(() => (toast.hidden = true), 6000);
    }
    const post = (action, body) => fetch(action, { method: "POST", body, headers: { "x-spots": "in-page" } });
    // A card taken off the list folds away, then the rest close up.
    function fold(li) {
      if (!li || still.matches) return Promise.resolve();
      li.style.overflow = "hidden";
      const h = li.getBoundingClientRect().height;
      return li
        .animate(
          [{ opacity: 1, height: `${h}px` }, { opacity: 0, height: "0px", paddingTop: "0px", paddingBottom: "0px" }],
          { duration: 260, easing: "ease-in", fill: "forwards" },
        )
        .finished.catch(() => {});
    }
    // A keen, a Remove, or anything for the plan posts in the background, so
    // the page (and its order) stays put. If Spots can't be reached (no
    // signal, the server down a moment), the page says so and stays as it
    // is, with Try again; refused (signed out, say), the form posts the
    // plain way, so the server's answer explains.
    const inPage = "[data-keen], [data-remove], [data-plan], [data-busy], [data-plan-start], [data-note], [data-seen]";
    // (moving the plan to another day starts its answers afresh: asked
    // first, but only when the day really changes)
    const asks = (form) => {
      if (!form.dataset.confirm) return false;
      if (!form.matches("[data-plan-start]") || !form.dataset.day) return true;
      const day = form.querySelector("input[name=date]")?.value || form.querySelector("input[name=day]:checked")?.value;
      return day !== form.dataset.day;
    };
    document.addEventListener("submit", async (event) => {
      const form = event.target.closest(inPage);
      if (!form) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      // Sending rather than disabled: disabling would drop the keyboard focus.
      if (form.dataset.sending || (form.matches("[data-keen], [data-remove]") && performance.now() - movedAt < 450)) return;
      // (this handler comes first, so it asks what the owner's confirm would)
      if (asks(form) && !window.confirm(form.dataset.confirm)) return;
      // (the button pressed is part of what's sent: "I'm free all day")
      const body = new FormData(form);
      const by = event.submitter;
      if (by?.name) body.set(by.name, by.value);
      form.dataset.sending = "true";
      try {
        const res = await post(form.getAttribute("action"), body);
        if (form.matches("[data-plan], [data-busy], [data-plan-start]")) {
          if (res.status !== 204 && res.status !== 409) throw new Error(String(res.status));
          form.closest("dialog")?.close();
          form.closest("details")?.removeAttribute("open");
          await refresh();
          if (res.status === 409) say(form.matches("[data-plan-start]") ? "That didn't work: pick one to five places on the list, a day from today on, and how long it takes within the hours you count." : "The plan changed meanwhile. Here it is as it is now.");
          else if (form.matches("[data-busy]")) say("Your times are in. The others see how many are free, never when you're busy.");
          return;
        }
        if (form.matches("[data-remove]")) {
          if (res.status === 409) {
            say(form.closest("li")?.hasAttribute("data-planned") ? "That one's in the plan: while it's on, only the owner can take it off." : "That one stays: someone else is keen on it now.");
            await refresh();
            return;
          }
          if (!res.ok) throw new Error(String(res.status));
          const name = form.dataset.remove;
          const li = form.closest("li");
          const place = li?.dataset.placeId;
          leaving = fold(li);
          await refresh();
          leaving = null;
          say(`Took ${name} off the list.`, place && (async () => {
            const body = new FormData();
            body.set("place", place);
            await post(form.getAttribute("action"), body);
            await refresh();
          }));
          return;
        }
        if (!res.ok) throw new Error(String(res.status));
        await refresh();
        if (form.matches("[data-note]")) {
          const note = form.elements.note.value.trim().replace(/\s+/g, " ");
          document.querySelector(".share__note-act").textContent = note ? "Edit note" : "Add a note";
          openMore(null);
          say(note ? "Note saved. It's the first thing people see when they open the link." : "Note taken down.");
        }
      } catch (error) {
        const status = Number(error?.message);
        if (!status || status >= 500) {
