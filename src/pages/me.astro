---
import Base from "../layouts/Base.astro";
import { listPasskeys } from "../lib/accounts";
import { groupsOfAccount } from "../lib/db";
import { signedIn } from "../lib/me";

// Your account: every group you're in, on any device, your one name, and
// the passkeys that can sign in as you.
const account = signedIn(Astro.cookies);
if (!account) return Astro.redirect("/signin", 303);
const groups = groupsOfAccount(account.id);
const passkeys = listPasskeys(account.id);
const day = (sqlite: string) =>
  new Date(`${sqlite.replace(" ", "T")}Z`).toLocaleDateString("en-AU", { day: "numeric", month: "short", year: "numeric" });
const error = Astro.url.searchParams.get("error");
const done = Astro.url.searchParams.get("done");
---

<Base title="My groups · Spots">
  <div class="me">
    <section class="group-head">
      <p class="eyebrow">Signed in</p>
      <h1>{account.name}'s groups</h1>
      {account.isAdmin && (
        <p class="fine">
          You're a site admin: <a href="/admin">open Admin</a> to archive test groups and hide shared places.
        </p>
      )}
    </section>

    {groups.length === 0 ? (
      <p class="empty">You're not in any groups right now. <a href="/#start">Start one</a>, or open a friend's invite link.</p>
    ) : (
      <ul class="my-groups">
        {groups.map((g) => (
          <li>
            <a class="card my-group" href={`/g/${g.link}`}>
              <strong>{g.name}</strong>
              <span class="fine">
                {g.people} {g.people === 1 ? "person" : "people"}
                {g.owner && " · you're the owner"}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}

    <section class="card account" id="you" aria-labelledby="you-title">
      <h2 id="you-title">Your name</h2>
      {done === "renamed" && <p class="notice notice--ok" role="status">Saved. It's your name in every group now.</p>}
      {error === "name" && <p class="notice" role="alert">Type a name so your friends know it's you.</p>}
      <form method="post" action="/api/account" class="settings__row">
        <label class="grow">
          <span class="sr-only">Your name</span>
          <input name="name" required maxlength="40" value={account.name} autocomplete="nickname" />
        </label>
        <button class="btn">Save</button>
      </form>
      <p class="fine">One name for you everywhere: changing it here changes it in all your groups.</p>
    </section>

    <section class="card account" id="keys" aria-labelledby="keys-title">
      <h2 id="keys-title">Your passkeys</h2>
      {done === "removed" && <p class="notice notice--ok" role="status">Removed. That passkey can't sign in any more.</p>}
      {error === "last" && <p class="notice" role="alert">That's your only passkey, so it stays: it's your way in.</p>}
      <ul class="keys">
        {passkeys.map((p) => (
          <li>
            <div>
              <strong>{p.keeper ?? p.madeOn ?? "A passkey"}</strong>
              <span class="fine">
                {p.keeper && p.madeOn && `Made on ${p.madeOn} · `}
                {p.synced ? "syncs to your other devices" : "on this one device only"}
                {` · added ${day(p.createdAt)}`}
                {p.lastUsedAt && ` · last used ${day(p.lastUsedAt)}`}
              </span>
            </div>
            {passkeys.length > 1 && (
              <form
                method="post"
                action="/api/passkeys/remove"
                data-confirm="Remove this passkey? It won't sign in to Spots any more. Remove it from your password manager too."
              >
                <input type="hidden" name="id" value={p.id} />
                <button class="btn btn--small btn--ghost">Remove</button>
              </form>
            )}
          </li>
        ))}
      </ul>
      <div data-passkey-only class="stack-row">
        <button type="button" class="btn" data-passkey="register">Add a passkey on this device</button>
        <span class="passkey-msg" aria-live="polite"></span>
      </div>
      <form method="post" action="/api/signout">
        <button class="btn btn--ghost">Sign out</button>
      </form>
    </section>
  </div>
  <script>
    import "../scripts/passkeys";
    // (asks before a form marked data-confirm goes)
    document.addEventListener("submit", (event) => {
      const form = event.target as HTMLFormElement;
      if (form.dataset.confirm && !confirm(form.dataset.confirm)) event.preventDefault();
    });
  </script>
</Base>
