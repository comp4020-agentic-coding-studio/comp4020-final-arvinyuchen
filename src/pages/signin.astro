---
import Base from "../layouts/Base.astro";
import { signedIn } from "../lib/me";

if (signedIn(Astro.cookies)) return Astro.redirect("/me", 303);
---

<Base title="Sign in · Spots">
  <section class="card notice-page">
    <p class="eyebrow">Sign in</p>
    <h1>Sign in with your passkey</h1>
    <p>
      Use the passkey you saved in one of your groups: your face, fingerprint or phone PIN. There's no password and no
      username to remember.
    </p>
    <div data-passkey-only hidden class="stack-row">
      <button type="button" class="btn btn--primary" data-passkey="signin" data-next="/me">Sign in with a passkey</button>
      <span class="passkey-msg" aria-live="polite"></span>
    </div>
    <p class="fine" data-no-passkey>
      No passkey yet? You don't need one to use Spots: open your group's link and join with your name. Once you're in,
      you can save a passkey there.
    </p>
  </section>
  <script>
    import "../scripts/passkeys";
  </script>
</Base>
