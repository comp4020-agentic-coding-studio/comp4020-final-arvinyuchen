---
import "../styles.css";
import { signedIn } from "../lib/me";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "Spots: a shared list of places for one group of friends to explore and vote on." } = Astro.props;
const account = signedIn(Astro.cookies);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='16' cy='14' r='9' fill='%23e8573a'/><circle cx='16' cy='14' r='3.5' fill='%23fff8ef'/><path d='M16 31 9 20h14z' fill='%23e8573a'/></svg>" />
    <title>{title}</title>
  </head>
  <body>
    <header class="top">
      <a class="brand" href="/"><span class="brand__pin" aria-hidden="true"></span>Spots</a>
      <nav aria-label="site">
        <a href="/readme/">About</a>
        {account ? <a href="/me">My groups</a> : <a href="/signin">Sign in</a>}
        <a class="top__cta" href="/#start">New group</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="foot">
      <div class="foot__main">
        <p>
          <span class="brand__pin" aria-hidden="true"></span> Spots: places to go in Canberra, picked together by one group
          of friends.
        </p>
        <nav class="foot__links" aria-label="footer">
          <a href="/readme/">How it works and why</a>
          <a href="/#start">Start a group</a>
          {account ? <a href="/me">My groups</a> : <a href="/signin">Sign in</a>}
        </nav>
      </div>
      <p class="foot__credits">
        Map data ©{" "}<a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>; map tiles
        by{" "}<a href="https://openfreemap.org">OpenFreeMap</a>; place lookup by{" "}
        <a href="https://nominatim.org">Nominatim</a>. Photos from{" "}
        <a href="https://commons.wikimedia.org">Wikimedia Commons</a>, credited on each card. Headings in Nunito,{" "}
        <a href="/fonts/Nunito-OFL.txt">SIL Open Font License</a>. Search by meaning with{" "}
        <a href="https://www.voyageai.com">Voyage AI</a> embeddings.
      </p>
    </footer>
  </body>
</html>
