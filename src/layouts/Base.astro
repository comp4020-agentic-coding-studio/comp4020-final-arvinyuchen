---
import "../styles.css";
import { signedIn } from "../lib/me";

interface Props {
  title: string;
  description?: string;
  /** How the page looks as a link in a chat: the card Messages, WhatsApp and the rest build from it. */
  share?: { title: string; description: string; url: string };
  /** A page trying out a design direction before the whole site moves (see styles.css). */
  theme?: "canberra";
}
const { title, description = "Spots: a shared list of places for one group of friends to explore and vote on." } = Astro.props;
const share = Astro.props.share ?? { title, description, url: new URL(Astro.url.pathname, Astro.url).href };
const shareImage = new URL("/og.png", Astro.url).href;
const account = signedIn(Astro.cookies);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Spots" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={share.title} />
    <meta property="og:description" content={share.description} />
    <meta property="og:url" content={share.url} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Spots: places to go, picked together" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='16' cy='14' r='9' fill='%23e8573a'/><circle cx='16' cy='14' r='3.5' fill='%23fff8ef'/><path d='M16 31 9 20h14z' fill='%23e8573a'/></svg>" />
    <title>{title}</title>
  </head>
  <body class:list={[Astro.props.theme && `theme-${Astro.props.theme}`]}>
    <header class="top">
      <a class="brand" href="/"><span class="brand__pin" aria-hidden="true"></span>Spots</a>
      <nav aria-label="site">
        {account ? <a href="/me">My groups</a> : <a href="/signin">Sign in</a>}
        <a class="top__cta" href="/#start">New group</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="foot">
      <a class="foot__link" href="/readme/">About</a>
      <details class="foot__credits">
        <summary>Credits</summary>
        <p>
        Map data ©{" "}<a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>; map tiles
        by{" "}<a href="https://openfreemap.org">OpenFreeMap</a>; place lookup by{" "}
        <a href="https://nominatim.org">Nominatim</a>. Photos from{" "}
        <a href="https://commons.wikimedia.org">Wikimedia Commons</a>, credited on each card. Headings in Nunito,{" "}
        <a href="/fonts/Nunito-OFL.txt">SIL Open Font License</a>. Search by meaning with{" "}
        <a href="https://www.voyageai.com">Voyage AI</a> embeddings. <slot name="credits" />
        </p>
      </details>
    </footer>
  </body>
</html>
