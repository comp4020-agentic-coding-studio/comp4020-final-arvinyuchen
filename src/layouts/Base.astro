---
import "../styles.css";
import { signedIn } from "../lib/me";

interface Props {
  title: string;
  description?: string;
  /** How the page looks as a link in a chat: the card Messages, WhatsApp and the rest build from it. */
  share?: { title: string; description: string; url: string };
  /** The header's New group button; off on the home page, whose own form is the way to start one. */
  newGroup?: boolean;
}
const { title, description = "Spots: a shared list of places for one group of friends to explore and vote on." } = Astro.props;
const share = Astro.props.share ?? { title, description, url: new URL(Astro.url.pathname, Astro.url).href };
const shareImage = new URL("/og.jpg", Astro.url).href;
const account = signedIn(Astro.cookies);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Spots" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={share.title} />
    <meta property="og:description" content={share.description} />
    <meta property="og:url" content={share.url} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Spots: places to go, picked together" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='16' cy='14' r='9' fill='%230b6e88'/><circle cx='16' cy='14' r='3.5' fill='%23f7fafb'/><path d='M16 31 9 20h14z' fill='%230b6e88'/></svg>" />
    <title>{title}</title>
    {/* Whether this browser can sign in with a passkey, before anything
        paints: html.passkeys shows the passkey buttons, otherwise the note
        saying to open the page in Safari or Chrome shows instead
        (src/components/NoPasskey.astro). Other apps' built-in browsers
        (Instagram, Facebook, WeChat...) say they have passkeys and then
        can't make one, so they count as without (html.in-app). */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const inApp = /Instagram|FBAN|FBAV|FB_IAB|FBIOS|MicroMessenger|\bLine\/|musical_ly|BytedanceWebview|Snapchat|LinkedInApp/.test(navigator.userAgent);
        if (inApp) root.classList.add("in-app");
        else if (typeof window.PublicKeyCredential === "function") root.classList.add("passkeys");
      })();
    </script>
  </head>
  <body>
    <header class="top" role="banner">
      <a class="brand" href="/"><span class="brand__pin" aria-hidden="true"></span>Spots</a>
      <nav aria-label="site">
        {account ? <a href="/me">My groups</a> : <a href="/signin">Sign in</a>}
        {Astro.props.newGroup !== false && <a class="top__cta" href="/#start">New group</a>}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="foot">
      <a class="foot__link" href="/readme/">About</a>
      <details class="foot__credits">
        <summary>Credits</summary>
        <p>
        Map data ©{" "}<a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>; map tiles
        by{" "}<a href="https://openfreemap.org">OpenFreeMap</a>. Finding a place to share searches{" "}
        <a href="https://overturemaps.org">Overture Maps Foundation</a>'s places (CDLA Permissive 2.0), and
        OpenStreetMap through <a href="https://photon.komoot.io">Photon</a> by komoot. Photos from{" "}
        <a href="https://commons.wikimedia.org">Wikimedia Commons</a> and members, credited on each card; the
        pictures of each kind from <a href="https://unsplash.com">Unsplash</a>. Search by meaning with{" "}
        <a href="https://www.voyageai.com">Voyage AI</a> embeddings. The photo of Canberra is by{" "}
        <a href="https://unsplash.com/photos/cityscape-during-daytime-QkcWZlBHykg" rel="noopener">Linda Xu on Unsplash</a>.{" "}
        <slot name="credits" />
        </p>
      </details>
    </footer>
  </body>
</html>
