---
import { formatMinute } from "../lib/when";

// How many are free through the plan's hours, as one strip: deeper blue
// where more are free, grey where nobody is. A thin blue ring singles out
// one stretch (the set time, the owner's pick, or the best window), only
// when there's something to single out: two answers or more, and less
// than the whole strip.
// Counts only, never whose. The strip is a picture of the windows listed
// under it, so a screen reader reads those instead.
interface Props {
  heat: { from: number; to: number; free: number }[];
  range: { start: number; end: number };
  total: number;
  mark?: { from: number; to: number };
  /** what the ring is: "the set time", "your pick", "the best time" */
  markLabel?: string;
}
const { heat, range, total, markLabel } = Astro.props;
const mark = Astro.props.mark && total >= 2 && (Astro.props.mark.from > range.start || Astro.props.mark.to < range.end) ? Astro.props.mark : undefined;
const span = range.end - range.start;
const at = (m: number) => `${(((m - range.start) / span) * 100).toFixed(3)}%`;
const wide = (a: number, b: number) => `${(((b - a) / span) * 100).toFixed(3)}%`;
// (more free, more blue, rising slowly so "all" stands out from "most")
const tint = (free: number) => (free && total ? Math.round(((free / total) ** 1.6) * 100) : 0);
// a time every three hours from the start, and the end
const ticks = [];
for (let m = range.start; m < range.end - 60; m += 180) ticks.push(m);
ticks.push(range.end);
const hours = [];
for (let m = Math.ceil(range.start / 60) * 60 + 60; m < range.end; m += 60) hours.push(m);
---

<div class="heat" aria-hidden="true" data-from={range.start} data-to={range.end}>
  <div class="heat__bar">
    <div class="heat__fill">
      {heat.map((s) => (
        <i style={`left: ${at(s.from)}; width: ${wide(s.from, s.to)}; background: color-mix(in srgb, var(--accent) ${tint(s.free)}%, var(--line))`}></i>
      ))}
      {hours.map((m) => <b style={`left: ${at(m)}`}></b>)}
    </div>
    {mark && <span class="heat__mark" style={`left: ${at(mark.from)}; width: ${wide(mark.from, mark.to)}`}></span>}
  </div>
  <div class="heat__axis">
    {ticks.map((m, i) => (
      <span class:list={{ "is-first": i === 0, "is-last": i === ticks.length - 1 }} style={`left: ${at(m)}`}>{formatMinute(m)}</span>
    ))}
  </div>
  {/* (a key that reads as the scale it is, not kinds: grey to blue) */}
  <div class="heat__key">
    <span>{total === 1 ? "busy" : "nobody"}</span>
    <i class="heat__scale"></i>
    <span>{total === 1 ? "free" : `all ${total}`}</span>
    {mark && markLabel && <span class="heat__ringkey">Outlined: {markLabel}</span>}
  </div>
</div>
