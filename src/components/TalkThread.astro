---
import type { Group } from "../lib/db";
import { REACTIONS, type Thread } from "../lib/talk";
import { addDays, formatDay, formatMinute, localNow, today } from "../lib/when";

// A place's thread: its messages, oldest at the top, each with who said it
// and when (Canberra's clock), yours on the right. A run of messages from
// one person close together says their name once. A deleted message is a
// stub without its words; your own, while it can be, has Undo. Your own
// has a small bin beside it, shown on hover (on a phone, after a long
// press), that deletes it, with Undo after. Any message can have quick
// reactions, one each: a smiley beside it (the same hover or long press)
// opens five, and they show under it, a tap on one adding yours. Words are
// text, never HTML: a web address in them is a link, and only that.
// The page's thread (?talk=) and the thread route (a live refresh, Earlier
// messages) both draw it.
interface Props {
  group: Group;
  thread: Thread;
  placeName: string;
  /** where "Earlier messages" goes without a script */
  base: string;
}
const { group, thread, placeName, base } = Astro.props;
const { messages, earlier, placeId } = thread;
const action = `/api/groups/${group.id}/talk`;

const now = today();
const dayLabel = (day: string) => (day === now ? "Today" : day === addDays(now, -1) ? "Yesterday" : formatDay(day));
const said = messages.map((m, i) => {
  const at = localNow(new Date(m.createdAt));
  const prev = messages[i - 1];
  const prevAt = prev && localNow(new Date(prev.createdAt));
  const newDay = !prevAt || prevAt.day !== at.day;
  // (the same person again within five minutes: no name, closer under the last)
  const run = !newDay && prev && prev.memberId === m.memberId && !prev.deleted && !m.deleted && at.minute - prevAt.minute < 5;
  return { ...m, day: at.day, time: formatMinute(at.minute), newDay, run };
});

// A web address in the words, as a link (http and https only); the rest as text.
const link = /\bhttps?:\/\/[^\s<>"']+/g;
const parts = (text: string) => {
  const out: { text: string; href?: string }[] = [];
  let last = 0;
  for (const match of text.matchAll(link)) {
    // (a full stop or a bracket after an address is the sentence's, not the address's)
    const href = match[0].replace(/[.,;:!?)\]]+$/, "");
    out.push({ text: text.slice(last, match.index) }, { text: href, href });
    last = match.index + href.length;
  }
  out.push({ text: text.slice(last) });
  return out.filter((p) => p.text);
};
---

<div class="talk__thread" data-thread={placeId} data-first={messages[0]?.id} data-last={messages.at(-1)?.id}>
  {earlier && (
    <a class="talk__earlier" href={`${base}&before=${messages[0].id}#talk`} data-talk-earlier={messages[0].id}>Earlier messages</a>
  )}
  {messages.length === 0 ? (
    <div class="talk__empty">
      <span class="talk__empty-icon" aria-hidden="true">
        <svg viewBox="0 0 20 20" width="22" height="22"><path d="M10 3.5c-3.9 0-7 2.5-7 5.6 0 1.8 1 3.4 2.7 4.4-.1.9-.6 1.7-1.2 2.3 1.4.1 2.7-.4 3.6-1.2.6.1 1.2.2 1.9.2 3.9 0 7-2.5 7-5.7s-3.1-5.6-7-5.6Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
      </span>
      <p class="talk__empty-title">No messages yet</p>
      <p class="talk__empty-sub">Ask the group about {placeName}.</p>
    </div>
  ) : (
    <ol class="talk__list" aria-label={`Talk about ${placeName}`}>
      {said.map((m) => (
        <>
          {m.newDay && <li class="talk__day" aria-hidden="true">{dayLabel(m.day)}</li>}
          <li
            id={`msg-${m.id}`}
            class:list={["msg", { "msg--mine": m.mine, "msg--run": m.run, "msg--removed": m.deleted }]}
            data-msg={m.id}
          >
            {m.deleted ? (
              <div class="msg__stub">
                <span>{m.mine ? "You removed this message" : "Message removed"}</span>
                {m.undoable && (
                  <form method="post" action={action} data-talk data-talk-undo>
                    <input type="hidden" name="action" value="undo" />
                    <input type="hidden" name="place" value={placeId} />
                    <input type="hidden" name="message" value={m.id} />
                    <button class="msg__undo">Undo</button>
                  </form>
                )}
              </div>
            ) : (
              <>
                {!m.run && (
                  <p class="msg__who">
                    {!m.mine && <strong>{m.name}</strong>}
                    <time datetime={m.createdAt}>{m.time}</time>
                  </p>
                )}
                <div class="msg__row">
                  <p class="msg__bubble">
                    <span class="sr-only">{m.mine ? "You" : m.name}{m.run && `, ${m.time}`}: </span>
                    {parts(m.body ?? "").map((p) => (p.href ? <a href={p.href} rel="nofollow noopener noreferrer ugc" target="_blank">{p.text}</a> : p.text))}
                  </p>
                  <div class="msg__tools">
                    <button
                      type="button"
                      class="msg__tool"
                      aria-label="React"
                      aria-expanded="false"
                      aria-controls={`react-${m.id}`}
                      data-react-open
                    >
                      <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><circle cx="10" cy="10" r="6.75" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M7.4 11.6c.6.9 1.5 1.4 2.6 1.4s2-.5 2.6-1.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /><circle cx="7.7" cy="8.4" r="1" fill="currentColor" /><circle cx="12.3" cy="8.4" r="1" fill="currentColor" /></svg>
                    </button>
                    {m.mine && (
                      <form method="post" action={action} class="msg__del" data-talk data-talk-delete>
                        <input type="hidden" name="action" value="delete" />
                        <input type="hidden" name="place" value={placeId} />
                        <input type="hidden" name="message" value={m.id} />
                        <button class="msg__tool msg__tool--delete" aria-label="Delete your message">
                          <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true"><path d="M4.5 6h11M8 6V4.5h4V6m-6 0 .6 9.2a1 1 0 0 0 1 .8h4.8a1 1 0 0 0 1-.8L14 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </button>
                      </form>
                    )}
                  </div>
                  <form method="post" action={action} class="msg__picker" id={`react-${m.id}`} hidden data-talk data-talk-react>
                    <input type="hidden" name="action" value="react" />
                    <input type="hidden" name="place" value={placeId} />
                    <input type="hidden" name="message" value={m.id} />
                    {REACTIONS.map((emoji) => (
                      <button
                        name="emoji"
                        value={emoji}
                        class:list={["msg__pick", { "is-mine": m.reactions.some((r) => r.mine && r.emoji === emoji) }]}
                        aria-label={`React ${emoji}`}
                      >
                        {emoji}
                      </button>
                    ))}
                  </form>
                </div>
                {m.reactions.length > 0 && (
                  <form method="post" action={action} class="msg__reactions" data-talk data-talk-react>
                    <input type="hidden" name="action" value="react" />
                    <input type="hidden" name="place" value={placeId} />
                    <input type="hidden" name="message" value={m.id} />
                    {m.reactions.map((r) => (
                      <button
                        name="emoji"
                        value={r.emoji}
                        class:list={["msg__chip", { "is-mine": r.mine }]}
                        aria-pressed={r.mine ? "true" : "false"}
                        aria-label={`${r.emoji} from ${r.names.join(", ")}`}
                        title={r.names.join(", ")}
                      >
                        {r.emoji}
                        {r.names.length > 1 && <span class="msg__chip-n">{r.names.length}</span>}
                      </button>
                    ))}
                  </form>
                )}
              </>
            )}
          </li>
        </>
      ))}
    </ol>
  )}
  <span id="talk-end"></span>
</div>
