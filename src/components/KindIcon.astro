---
import { KIND_ICON, VIEW_BOX } from "../lib/kind-icons";
import type { Kind } from "../lib/kinds";

// A kind's glyph (src/lib/kind-icons.ts), sized to the text beside it and
// in its colour. Decorative: the kind's name is always there too.
interface Props {
  kind: Kind;
}
const { kind } = Astro.props;
---

<svg class="kind-icon" viewBox={VIEW_BOX} fill="currentColor" aria-hidden="true"><path d={KIND_ICON[kind]} /></svg>
