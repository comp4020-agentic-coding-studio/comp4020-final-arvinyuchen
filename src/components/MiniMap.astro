---
import type { Kind } from "../lib/catalogue";
import { at, H, W, where } from "../lib/hero-frame";
import { SUBURBS } from "../lib/hero-map-data";
import MapDrawing from "./MapDrawing.astro";

// A small map with a few numbered pins: where a group's places are, at a
// glance. The page draws it whole with no script and no tiles to load, and
// src/scripts/minimap.ts lays the real street map over it once that's in
// (MapLibre is already on the page for the group's own map). The still map is
// the home page's drawing (MapDrawing.astro) zoomed to fit the pins, wearing
// the street map's marks as near as a drawing can: white chips with the
// number and name, and the suburbs' names in the page's font. A place
// outside that frame (Tidbinbilla) is left off the map but stays in the list
// beside it.
interface Props {
  pins: { n: number; name: string; area: string | null; kind: Kind; lat: number | null; lon: number | null }[];
}

const ASPECT = 16 / 10;
const PAD = 60;
const placed = Astro.props.pins
  .filter((p) => p.lat !== null && p.lon !== null)
  .map((p) => ({ ...p, ...at(p.lat!, p.lon!) }))
  .filter(({ x, y }) => x > 0 && x < W && y > 0 && y < H);

// The smallest box around the pins (with room for them and a suburb name or
// two), stretched to the map's shape and kept inside the frame.
let box = { x: 0, y: 0, w: W, h: W / ASPECT };
if (placed.length > 0) {
  const xs = placed.map((p) => p.x);
  const ys = placed.map((p) => p.y);
  let w = Math.max(Math.max(...xs) - Math.min(...xs) + 2 * PAD, 200);
  let h = Math.max(Math.max(...ys) - Math.min(...ys) + 2 * PAD, 200 / ASPECT);
  if (w / h < ASPECT) w = h * ASPECT;
  else h = w / ASPECT;
  w = Math.min(w, W);
  h = w / ASPECT;
  const cx = (Math.min(...xs) + Math.max(...xs)) / 2;
  const cy = (Math.min(...ys) + Math.max(...ys)) / 2;
  const clamp = (v: number, lo: number, hi: number) => Math.min(Math.max(v, lo), hi);
  box = { x: clamp(cx - w / 2, 0, W - w), y: clamp(cy - h / 2, 0, H - h), w, h };
}
// Sizes in the picture's units, a thirtieth of its width: about a chip's
// height on the card.
const u = box.w / 30;
const label = box.w / 40;
// Each pin is a chip over its place, as on the street map: the number in a
// disc, the name at about half an em a letter, slid to stay inside the map.
const pins = placed.map((p) => {
  const wide = 1.9 * u + p.name.length * u * 0.56 * 0.75 + 0.6 * u;
  const lo = box.x + 0.3 * u;
  const hi = box.x + box.w - 0.3 * u - wide;
  const x0 = Math.min(Math.max(p.x - wide / 2, lo), Math.max(hi, lo));
  // What the chip covers, so no suburb name is printed under it.
  const covers = { x0, x1: x0 + wide, y0: p.y - 2.5 * u, y1: p.y + 0.4 * u };
  return { ...p, x0: x0 - p.x, wide, covers };
});
// Only suburb names that fit whole inside the map ("Bradd" helps nobody)
// and aren't under a pin's chip.
const half = (s: string) => (s.length * label * 0.58) / 2;
const suburbs = SUBURBS.filter(
  (s) =>
    s.x - half(s.name) > box.x &&
    s.x + half(s.name) < box.x + box.w &&
    s.y - label > box.y &&
    s.y < box.y + box.h &&
    !pins.some(({ covers: c }) => s.x + half(s.name) > c.x0 && s.x - half(s.name) < c.x1 && s.y > c.y0 && s.y - label < c.y1),
).slice(0, 5);
// What the street map needs to pin the same places.
const live = JSON.stringify(
  Astro.props.pins
    .filter((p) => p.lat !== null && p.lon !== null)
    .map(({ n, name, kind, lat, lon }) => ({ n, name, kind, lat, lon })),
);
// The names the street map may print (it uses the page's font for them):
// the lake's, then the suburbs, from the same OpenStreetMap data.
const places = JSON.stringify([
  { name: "Lake Burley Griffin", water: true, lat: -35.2899, lon: 149.0989 },
  ...SUBURBS.map((s) => ({ name: s.name, water: false, ...where(s.x, s.y) })),
]);
const said = placed.map((p) => `${p.n}, ${p.name}${p.area ? ` in ${p.area}` : ""}`).join("; ");
---

{placed.length > 0 && (
  <figure class="minimap" data-pins={live} data-places={places}>
    <svg
      class="minimap__map"
      viewBox={`${box.x.toFixed(1)} ${box.y.toFixed(1)} ${box.w.toFixed(1)} ${box.h.toFixed(1)}`}
      preserveAspectRatio="xMidYMid slice"
      role="img"
      aria-label={`Map of central Canberra with the places pinned: ${said}.`}
    >
      <defs>
        <filter id="minimap-lift" x="-50%" y="-50%" width="200%" height="200%">
          <feDropShadow dx="0" dy={(u * 0.12).toFixed(2)} stdDeviation={(u * 0.2).toFixed(2)} flood-color="#0d2b36" flood-opacity="0.22" />
        </filter>
      </defs>
      <MapDrawing fixed />
      {suburbs.map((s) => (
        <text class="minimap__suburb" x={s.x} y={s.y} font-size={label.toFixed(1)}>{s.name}</text>
      ))}
      {pins.map((p) => (
        <g class={`spot--${p.kind}`} transform={`translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`}>
          <g class="minimap__pin" style={`--n: ${p.n}`}>
            <g filter="url(#minimap-lift)">
              <rect class="minimap__chip" x={p.x0.toFixed(1)} y={(-2.35 * u).toFixed(1)} width={p.wide.toFixed(1)} height={(1.6 * u).toFixed(1)} rx={(0.8 * u).toFixed(1)}></rect>
              <rect class="minimap__chip" x={(-0.22 * u).toFixed(1)} y={(-0.97 * u).toFixed(1)} width={(0.44 * u).toFixed(1)} height={(0.44 * u).toFixed(1)} transform={`rotate(45 0 ${(-0.75 * u).toFixed(1)})`}></rect>
              <circle class="minimap__dot" r={(0.28 * u).toFixed(1)}></circle>
            </g>
            <circle class="minimap__disc" cx={(p.x0 + 0.8 * u).toFixed(1)} cy={(-1.55 * u).toFixed(1)} r={(0.62 * u).toFixed(1)}></circle>
            <text class="minimap__n" x={(p.x0 + 0.8 * u).toFixed(1)} y={(-1.55 * u).toFixed(1)} dy="0.36em" font-size={(0.68 * u).toFixed(1)}>{p.n}</text>
            <text class="minimap__name" x={(p.x0 + 1.75 * u).toFixed(1)} y={(-1.55 * u).toFixed(1)} dy="0.36em" font-size={(0.75 * u).toFixed(1)}>{p.name}</text>
          </g>
        </g>
      ))}
    </svg>
    <div class="minimap__live" aria-hidden="true"></div>
    <figcaption class="fold-credit">
      <span class="fold-credit__sources">
        © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a><span class="minimap__tiles">{" · "}<a href="https://openfreemap.org">OpenFreeMap</a></span>{" · relief "}<a href="https://github.com/tilezen/joerd/blob/master/docs/attribution.md">Mapzen</a>
      </span>
      <button type="button" class="fold-credit__info" aria-label="Map credits" aria-expanded="false">i</button>
    </figcaption>
  </figure>
)}

<script>
  import "../scripts/minimap";
</script>
