---
import type { Kind, Photo } from "../lib/catalogue";

// A spot's photo with its credit: a Commons photo with its author and
// licence, or the sharer's own with their name. Every place has one
// (src/lib/photos.ts); the panel's tint in the kind's colour shows only
// while it loads.
interface Props {
  photo: Photo;
  name: string;
  kind: Kind;
  small?: boolean;
}
const { photo, name, kind, small = false } = Astro.props;
---

<figure class:list={["photo", `photo--${kind}`, { "photo--small": small }]}>
  <img src={photo.src} alt={`${name}`} loading="lazy" decoding="async" width="800" height="533" />
  {
    !small && (
      <figcaption>
        <a href={photo.page} rel="noopener">
          Photo: {photo.credit}
          {photo.license && `, ${photo.license}`}
        </a>
      </figcaption>
    )
  }
</figure>
