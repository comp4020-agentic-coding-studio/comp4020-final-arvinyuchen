---
import type { Kind, Photo } from "../lib/catalogue";
import { KIND_ART } from "../lib/kind-art";
import { KIND_LABEL } from "../lib/kinds";
import KindIcon from "./KindIcon.astro";

// A spot's photo with its credit: a Commons photo with its author and
// licence, or the sharer's own with their name; the panel's tint in the
// kind's colour shows while it loads. A place without one shows its kind's
// picture (src/lib/kind-art.ts), or the kind's icon, named with the kind so
// it isn't taken for a photo of the place.
interface Props {
  photo: Photo | null;
  name: string;
  kind: Kind;
  small?: boolean;
}
const { photo, name, kind, small = false } = Astro.props;
const art = photo ? undefined : KIND_ART[kind];
---

{
  photo ? (
    <figure class:list={["photo", `photo--${kind}`, { "photo--small": small }]}>
      <img src={photo.src} alt={`${name}`} loading="lazy" decoding="async" width="800" height="533" />
      {!small && (
        <figcaption>
          <a href={photo.page} rel="noopener">
            Photo: {photo.credit}
            {photo.license && `, ${photo.license}`}
          </a>
        </figcaption>
      )}
    </figure>
  ) : (
    <figure class:list={["photo", "photo--kind", `photo--${kind}`, { "photo--small": small, "photo--art": art }]} data-kind-art={kind}>
      {art ? (
        <>
          <img src={art.src} alt="" loading="lazy" decoding="async" width="800" height="533" />
          {/* (too small to name the kind on, so its icon marks it instead) */}
          {small && <span class="photo__badge"><KindIcon kind={kind} /></span>}
        </>
      ) : (
        <>
          <span class="photo__icon"><KindIcon kind={kind} /></span>
          <span class="photo__ghost"><KindIcon kind={kind} /></span>
        </>
      )}
      {!small && (
        <figcaption>
          <span class="photo__kind">{KIND_LABEL[kind]}</span>
          {art && (
            <a href={art.page ?? "https://unsplash.com"} rel="noopener">
              {art.credit ? `Photo: ${art.credit}, Unsplash` : "Photo: Unsplash"}
            </a>
          )}
        </figcaption>
      )}
    </figure>
  )
}
