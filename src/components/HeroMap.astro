---
import { CATALOGUE, KIND_LABEL, type Kind } from "../lib/catalogue";
import { at, H, W } from "../lib/hero-frame";
import { CAMPUS, LAKE, MOTORWAYS, PARKS, PEAKS, RESERVES, ROADS, SUBURBS, WATER } from "../lib/hero-map-data";

// The home page's moving picture: the starter places dropping onto a sketch of
// Canberra as pins, then a few prompts answered the way Explore answers them,
// each with the matching place's real card. Pure CSS animation, no script; with
// reduced motion it's a still picture. Decorative (aria-hidden): the sentence
// in .sr-only says what it shows.
//
// Pins sit at each place's real coordinates (src/lib/catalogue.ts), projected
// into the frame (src/lib/hero-frame.ts). Places outside it (Tidbinbilla) are
// left off. Everything under the pins is OpenStreetMap's, built by
// scripts/build-hero-map.ts into src/lib/hero-map-data.ts: nothing is drawn by
// hand.
const inFrame = ({ x, y }: { x: number; y: number }) => x > 8 && x < W - 8 && y > 24 && y < H - 4;

const pins = CATALOGUE.map((s) => ({ ...s, ...at(s.lat, s.lon) })).filter(inFrame);

// The prompts, in order, and where each card opens from its pin so it stays
// inside the frame. Each prompt is a phrase from the matching place's own card.
const FEATURED: { key: string; ask: string; side: "above" | "below" | "left" | "right" }[] = [
  { key: "woolley-st", ask: "cheap dumplings", side: "below" },
  { key: "mt-ainslie", ask: "a walk with a view", side: "left" },
  { key: "questacon", ask: "something fun with friends", side: "above" },
  { key: "arboretum", ask: "room for a picnic", side: "right" },
];
const featured = FEATURED.map((f) => ({ ...f, spot: pins.find((p) => p.key === f.key)! })).filter((f) => f.spot);
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;
const order = new Map(featured.map((f, i) => [f.key, i]));
const tint: Record<Kind, string> = { food: "var(--food)", fun: "var(--fun)", outdoors: "var(--outdoors)" };

// The land axis, from Parliament House to the War Memorial: the one line on
// the map that isn't a road or a river, because it's the city's own plan.
const axis = [at(-35.3081, 149.1245), at(-35.2805, 149.1491)];

// Of the named peaks, the ones a visitor would know by name; the rest of the
// hills read as the reserves they sit in.
const LANDMARKS = new Set(["Black Mountain", "Mount Ainslie"]);
const peaks = PEAKS.filter((p) => LANDMARKS.has(p.name));
---

<figure class="hero-map" style={`--n: ${featured.length}`}>
  <p class="sr-only">
    Places shared on Spots, pinned on a map of Canberra, with a few searches answered by matching places.
  </p>
  <div class="hero-map__frame" aria-hidden="true">
    <div class="hero-map__ask">
      <span class="hero-map__glass"></span>
      <span class="hero-map__hint">Describe what you're after</span>
      {featured.map((f, i) => (
        <span class:list={["hero-map__q", { "is-first": i === 0 }]} style={`--i: ${i}`}>{f.ask}</span>
      ))}
    </div>
    <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice">
      <defs>
        <pattern id="hm-dots" width="14" height="14" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1" fill="rgb(120 100 70 / 0.16)"></circle>
        </pattern>
      </defs>
      <rect width={W} height={H} fill="#f8f0e2"></rect>
      <rect width={W} height={H} fill="url(#hm-dots)"></rect>
      {RESERVES.map((r) => <path class="hero-map__reserve" d={r.d} fill-rule="evenodd"></path>)}
      {PARKS.map((r) => <path class="hero-map__park" d={r.d} fill-rule="evenodd"></path>)}
      <path class="hero-map__campus" d={CAMPUS} fill-rule="evenodd"></path>
      <path class="hero-map__road" d={ROADS}></path>
      <path class="hero-map__road hero-map__road--major" d={MOTORWAYS}></path>
      <path class="hero-map__water" d={WATER}></path>
      <line
        class="hero-map__axis"
        x1={axis[0].x}
        y1={axis[0].y}
        x2={axis[1].x}
        y2={axis[1].y}
      ></line>
      <path class="hero-map__lake" d={LAKE} fill-rule="evenodd"></path>
      {SUBURBS.map((p) => <text class="hero-map__suburb" x={p.x} y={p.y}>{p.name}</text>)}
      {peaks.map((p) => (
        <g class="hero-map__peak" transform={`translate(${p.x} ${p.y})`}>
          <path d="M0 -5L5 3H-5Z"></path>
          <text x="0" y="15">{p.name}</text>
        </g>
      ))}
      <text class="hero-map__label" x="22" y={H - 22}>Canberra</text>
      {pins.map((p, i) => (
        <g transform={`translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`}>
          <g
            class:list={["hero-map__pin", { "hero-map__pin--featured": order.has(p.key) }]}
            style={`--d: ${(i * 0.16).toFixed(2)}s; --kind: ${tint[p.kind]}; --i: ${order.get(p.key) ?? 0}`}
          >
            <ellipse class="hero-map__shadow" cx="0" cy="1" rx="6" ry="2.2"></ellipse>
            <circle class="hero-map__ring" cx="0" cy="-16" r="12"></circle>
            <path d="M0 0C-4-7-10-11-10-17a10 10 0 1 1 20 0c0 6-6 10-10 17Z"></path>
            <circle cx="0" cy="-17" r="3.6" fill="#fff"></circle>
          </g>
        </g>
      ))}
    </svg>
    {featured.map((f, i) => (
      <div
        class:list={["hero-map__card", `hero-map__card--${f.side}`, `spot--${f.spot.kind}`, { "is-first": i === 0 }]}
        style={`--i: ${i}; left: ${pct(f.spot.x, W)}; top: ${pct(f.spot.y, H)}`}
      >
        <span class="tag">{KIND_LABEL[f.spot.kind]}</span>
        <strong>{f.spot.name}</strong>
        <span>{f.spot.blurb}</span>
      </div>
    ))}
  </div>
  <figcaption class="hero-map__credit">
    Map data ©{" "}<a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>
  </figcaption>
</figure>
