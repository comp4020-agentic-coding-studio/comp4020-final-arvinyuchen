---

<figure class="hero-map" style={`--n: ${featured.length}`}>
  <p class="sr-only">
    Places shared on Spots, pinned on a map of Canberra, with a few searches answered by matching places.
  </p>
  <div class="hero-map__frame" aria-hidden="true">
    <div class="hero-map__ask">
      <span class="hero-map__glass"></span>
      {featured.map((f, i) => (
        <span class:list={["hero-map__q", { "is-first": i === 0 }]} style={`--i: ${i}`}>{f.ask}</span>
      ))}
    </div>
    <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice">
      <defs>
        <pattern id="hm-dots" width="14" height="14" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1" fill="rgb(120 100 70 / 0.16)"></circle>
        </pattern>
        <radialGradient id="hm-hill">
          <stop offset="0" stop-color="#cfe3c4"></stop>
          <stop offset="1" stop-color="#cfe3c4" stop-opacity="0"></stop>
        </radialGradient>
      </defs>
      <rect width={W} height={H} fill="#f8f0e2"></rect>
      <rect width={W} height={H} fill="url(#hm-dots)"></rect>
      {hills.map((h) => <circle cx={h.x} cy={h.y} r="62" fill="url(#hm-hill)"></circle>)}
      <line
        class="hero-map__axis"
        x1={axis[0].x}
        y1={axis[0].y}
        x2={axis[1].x}
        y2={axis[1].y}
      ></line>
      <path class="hero-map__lake" d={LAKE} fill-rule="evenodd"></path>
      <text class="hero-map__label" x="22" y={H - 22}>Canberra</text>
      {pins.map((p, i) => (
        <g transform={`translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`}>
          <g
            class:list={["hero-map__pin", { "hero-map__pin--featured": order.has(p.key) }]}
            style={`--d: ${(i * 0.16).toFixed(2)}s; --kind: ${tint[p.kind]}; --i: ${order.get(p.key) ?? 0}`}
          >
            <ellipse class="hero-map__shadow" cx="0" cy="1" rx="6" ry="2.2"></ellipse>
            <circle class="hero-map__ring" cx="0" cy="-16" r="12"></circle>
            <path d="M0 0C-4-7-10-11-10-17a10 10 0 1 1 20 0c0 6-6 10-10 17Z"></path>
            <circle cx="0" cy="-17" r="3.6" fill="#fff"></circle>
          </g>
        </g>
      ))}
    </svg>
    {featured.map((f, i) => (
      <div
        class:list={["hero-map__card", `hero-map__card--${f.side}`, `spot--${f.spot.kind}`, { "is-first": i === 0 }]}
        style={`--i: ${i}; left: ${pct(f.spot.x, W)}; top: ${pct(f.spot.y, H)}`}
      >
        <span class="tag">{KIND_LABEL[f.spot.kind]}</span>
        <strong>{f.spot.name}</strong>
        <span>{f.spot.blurb}</span>
      </div>
    ))}
  </div>
  <figcaption class="hero-map__credit">Lake outline © OpenStreetMap contributors</figcaption>
</figure>
