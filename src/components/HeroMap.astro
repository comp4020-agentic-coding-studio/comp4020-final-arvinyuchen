---
import { CATALOGUE, KIND_LABEL, type Kind } from "../lib/catalogue";

// The home page's moving picture: the starter places dropping onto a sketch of
// Canberra as pins, then a few prompts answered the way Explore answers them,
// each with the matching place's real card. Pure CSS animation, no script; with
// reduced motion it's a still picture. Decorative (aria-hidden): the sentence
// in .sr-only says what it shows.
//
// Pins sit at each place's real coordinates (src/lib/catalogue.ts), projected
// into the frame below. Places outside it (Tidbinbilla) are left off.

const W = 560;
const H = 493;
const LON0 = 149.06;
const LAT0 = -35.243;
const SCALE = 6236.266; // px per degree of latitude; longitude shrinks by cos(lat)
const COS = Math.cos((35.28 * Math.PI) / 180);
const at = (lat: number, lon: number) => ({ x: (lon - LON0) * COS * SCALE, y: (LAT0 - lat) * SCALE });
const inFrame = ({ x, y }: { x: number; y: number }) => x > 8 && x < W - 8 && y > 24 && y < H - 4;

const pins = CATALOGUE.map((s) => ({ ...s, ...at(s.lat, s.lon) })).filter(inFrame);

// The prompts, in order, and where each card opens from its pin so it stays
// inside the frame. Each prompt is a phrase from the matching place's own card.
const FEATURED: { key: string; ask: string; side: "above" | "below" | "left" | "right" }[] = [
  { key: "woolley-st", ask: "cheap dumplings", side: "below" },
  { key: "mt-ainslie", ask: "a walk with a view", side: "left" },
  { key: "questacon", ask: "something fun with friends", side: "above" },
  { key: "arboretum", ask: "room for a picnic", side: "right" },
];
const featured = FEATURED.map((f) => ({ ...f, spot: pins.find((p) => p.key === f.key)! })).filter((f) => f.spot);
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;
const order = new Map(featured.map((f, i) => [f.key, i]));
const tint: Record<Kind, string> = { food: "var(--food)", fun: "var(--fun)", outdoors: "var(--outdoors)" };

// Hills and the land axis, for a sense of place: Black Mountain, Mount Ainslie,
// and the line from Parliament House to the War Memorial.
const hills = [at(-35.2755, 149.0972), at(-35.271, 149.1585)];
const axis = [at(-35.3081, 149.1245), at(-35.2805, 149.1491)];

// Lake Burley Griffin: OpenStreetMap relation 3400115 (© OpenStreetMap
// contributors, ODbL), simplified and smoothed into the frame above. Islands
// are holes in it.
