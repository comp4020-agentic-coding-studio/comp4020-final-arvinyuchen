---
import { CATALOGUE, KIND_LABEL } from "../lib/catalogue";
import { at, H, W } from "../lib/hero-frame";
import { PEAKS, SUBURBS } from "../lib/hero-map-data";
import MapDrawing from "./MapDrawing.astro";

// The home page's moving picture: the starter places dropping onto a sketch of
// Canberra as pins, then a few prompts answered the way Explore answers them,
// each with the matching place's real card. Pure CSS animation, no script; with
// reduced motion it's a still picture. Decorative (aria-hidden): the sentence
// in .sr-only says what it shows.
//
// Pins sit at each place's real coordinates (src/lib/catalogue.ts), projected
// into the frame (src/lib/hero-frame.ts). Places outside it (Tidbinbilla) are
// left off. It wears the live maps' marks (src/scripts/map-marks.ts and
// "Map marks" in styles.css): the places the prompts find are white name
// chips, the rest are dots, a few names are set in the page's font, and the
// credit folds behind an "i". Everything under them is OpenStreetMap's, drawn
// in the live maps' colours and line weights by MapDrawing.astro, over hills
// shaded from Mapzen's terrain: nothing is drawn by hand.
const inFrame = ({ x, y }: { x: number; y: number }) => x > 8 && x < W - 8 && y > 24 && y < H - 4;

const pins = CATALOGUE.map((s) => ({ ...s, ...at(s.lat, s.lon) })).filter(inFrame);

// The prompts, in order, and where each card opens from its pin so it stays
// inside the frame. Each prompt is a phrase from the matching place's own card.
// A chip that would run into the frame's top or the search box hangs below
// its place instead; one that would meet a hanging chip on the narrowest
// frames (a 320px phone) tucks under its place there (.hero-map__drop--tuck).
const FEATURED: {
  key: string;
  ask: string;
  side: "above" | "below" | "left" | "right";
  hang?: boolean;
  tuck?: boolean;
}[] = [
  { key: "bus-depot-markets", ask: "food stalls by the lake", side: "above" },
  { key: "mt-ainslie", ask: "a walk with a view", side: "left", tuck: true },
  { key: "questacon", ask: "something fun with friends", side: "above" },
  { key: "arboretum", ask: "room for a picnic", side: "right" },
];
const featured = FEATURED.map((f) => ({ ...f, spot: pins.find((p) => p.key === f.key)! })).filter((f) => f.spot);
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;
const byKey = new Map(featured.map((f, i) => [f.key, { ...f, i }]));
// A chip is centred over its place, or, one that hangs, starts there and runs
// right, clear of the search box; either way the CSS slides it back inside
// the frame however narrow that is (see .hero-map__chip), its tail still on
// the place.

// A few names, as the live maps print them (names() in map-marks.ts): the
// lake's, the hills a visitor would know, then the suburbs from the middle of
// town out, each only where it covers no pin, no chip, the search box or
// another name. The frame is a different size on a phone and a wide screen,
// so they're placed for both, in pixels: the names that only fit on the
// wide one wait for it (.hero-map__wide).
const LANDMARKS = new Set(["Black Mountain"]);
type Label = { name: string; x: number; y: number; water?: boolean; peak?: boolean };
const candidates: Label[] = [
  { name: "Lake Burley Griffin", water: true, ...at(-35.2899, 149.0989) },
  ...PEAKS.filter((p) => LANDMARKS.has(p.name) && !pins.some((s) => s.name === p.name)).map((p) => ({ ...p, peak: true })),
  ...[...SUBURBS].sort((a, b) => Math.hypot(a.x - W / 2, a.y - H / 2) - Math.hypot(b.x - W / 2, b.y - H / 2)),
];
type Box = { x0: number; x1: number; y0: number; y1: number };
const hits = (a: Box, b: Box) => a.x0 < b.x1 && b.x0 < a.x1 && a.y0 < b.y1 && b.y0 < a.y1;

function fit(frame: number, max: number, chipEm: number, ask: Box) {
  const k = frame / W;
  const chip = 16 * chipEm;
  const taken: Box[] = [ask];
  for (const p of pins) {
    const [x, y] = [p.x * k, p.y * k];
    taken.push({ x0: x - 8, x1: x + 8, y0: y - 8, y1: y + 8 });
    const f = byKey.get(p.key);
    if (!f) continue;
    // A chip's width, roughly: its name at about half an em a letter, its
    // disc and padding; and where it sits, kept inside the frame.
    const wide = p.name.length * chip * 0.56 + 34;
    const x0 = Math.min(Math.max(f.hang ? x - 14 : x - wide / 2, 6), frame - 6 - wide);
    taken.push({ x0: x0 - 6, x1: x0 + wide + 6, ...(f.hang ? { y0: y, y1: y + 40 } : { y0: y - 40, y1: y }) });
  }
  const shown: string[] = [];
  for (const c of candidates) {
    if (shown.length >= max) break;
    const [x, y] = [c.x * k, c.y * k];
    const half = (c.name.length * 10.5 * 0.58) / 2 + (c.peak ? 8 : 3);
    const box = { x0: x - half, x1: x + half, y0: y - 8, y1: y + 8 };
    if (box.x0 < 6 || box.x1 > frame - 6 || box.y0 < 6 || box.y1 > frame * (H / W) - 22) continue;
    if (taken.some((t) => hits(t, box))) continue;
    taken.push(box);
    shown.push(c.name);
  }
  return shown;
}
// The phone: a 375px screen less its gutters; the wide screen: a 540px
// frame (most show it wider, which only gives the names more room).
const phone = fit(343, 4, 0.68, { x0: 0, x1: 250, y0: 0, y1: 52 });
const wide = fit(540, 7, 0.75, { x0: 0, x1: 300, y0: 0, y1: 64 });
const labels = candidates.filter((c) => phone.includes(c.name) || wide.includes(c.name));
---

<figure class="hero-map" style={`--n: ${featured.length}`}>
  <p class="sr-only">
    Places shared on Spots, pinned on a map of Canberra, with a few searches answered by matching places.
  </p>
  <div class="hero-map__frame" aria-hidden="true">
    <div class="hero-map__ask">
      <span class="hero-map__glass"></span>
      <span class="hero-map__hint">Describe what you're after</span>
      {featured.map((f, i) => (
        <span class:list={["hero-map__q", { "is-first": i === 0 }]} style={`--i: ${i}`}>{f.ask}</span>
      ))}
    </div>
    <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice">
      <MapDrawing />
    </svg>
    {labels.map((l) => (
      <span
        class:list={[
          "map-label",
          { "map-label--water": l.water, "map-label--peak": l.peak, "hero-map__wide": !phone.includes(l.name) },
        ]}
        style={`left: ${pct(l.x, W)}; top: ${pct(l.y, H)}`}
      >{l.name}</span>
    ))}
    {pins.map((p, i) => {
      const f = byKey.get(p.key);
      return (
        <span
          class:list={["map-mark", "hero-map__pin", `spot--${p.kind}`, { "hero-map__pin--featured": f }]}
          style={`left: ${pct(p.x, W)}; top: ${pct(p.y, H)}; --x: ${((p.x / W) * 100).toFixed(2)}; --d: ${(i * 0.16).toFixed(2)}s; --i: ${f?.i ?? 0}`}
        >
          {f && <span class="hero-map__ring"></span>}
          <span class:list={["map-drop", { "is-below": f?.hang, "hero-map__drop--tuck": f?.tuck }]}>
            {f && (
              <span class:list={["map-chip", "hero-map__chip", { "hero-map__chip--start": f.hang, "is-first": f.i === 0 }]}>
                <i></i><b>{p.name}</b>
              </span>
            )}
            <span class="map-dot"></span>
          </span>
        </span>
      );
    })}
    {featured.map((f, i) => (
      <div
        class:list={["hero-map__card", `hero-map__card--${f.side}`, `spot--${f.spot.kind}`, { "is-first": i === 0 }]}
        style={`--i: ${i}; left: ${pct(f.spot.x, W)}; top: ${pct(f.spot.y, H)}`}
      >
        <span class="tag">{KIND_LABEL[f.spot.kind]}</span>
        <strong>{f.spot.name}</strong>
        <span>{f.spot.blurb}</span>
      </div>
    ))}
  </div>
  <figcaption class="fold-credit">
    <span class="fold-credit__sources">
      © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a><span class="hero-map__tiles">{" · "}<a href="https://openfreemap.org">OpenFreeMap</a></span>{" · relief "}<a href="https://github.com/tilezen/joerd/blob/master/docs/attribution.md">Mapzen</a>
    </span>
    {/* No script here: it opens on hover, or on the focus a tap gives it. */}
    <button type="button" class="fold-credit__info" aria-label="Map credits">i</button>
  </figcaption>
</figure>
